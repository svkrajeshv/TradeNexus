@page "/telegram"
@using MudBlazor
@using NexusApp.Telegram
@inject TelegramManager Manager
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>NexusApp - Telegram</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Telegram Integration</MudText>

<MudGrid Spacing="3">

    <!-- Connection status card -->
    <MudItem xs="12">
        <MudPaper Class="pa-3 pa-sm-4" Elevation="2">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Large" Color="Color.Primary" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Status</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_statusDescription</MudText>
                </MudStack>
                <MudSpacer />
                <MudChip T="string" Color="@StateColor(_state)" Variant="Variant.Filled" Size="Size.Small">@_state.ToString()</MudChip>
                @if (Manager.IsConnected)
                {
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                        @($"{Manager.Client.MeUsername} · {Manager.Client.ChatCount} chats")
                    </MudChip>
                }
            </MudStack>

            @if (_state == TelegramConnectionState.AwaitingCode)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Telegram sent a verification code. Enter it below:</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField T="string" @bind-Value="_code" Label="Verification code" Variant="Variant.Outlined"
                                  InputMode="InputMode.numeric" Class="flex-grow-1" />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitCode"
                               StartIcon="@Icons.Material.Filled.Check">Submit</MudButton>
                </MudStack>
            }
            else if (_state == TelegramConnectionState.AwaitingPassword)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Two-factor authentication is enabled. Enter your Telegram cloud password:</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField T="string" @bind-Value="_password" Label="2FA password" InputType="InputType.Password"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitPassword"
                               StartIcon="@Icons.Material.Filled.Lock">Submit</MudButton>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    <!-- Left Column: Authentication, Trade Order Notifications & Signal Forwarding -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Authentication</MudText>
                <MudSwitch T="bool" @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable Telegram listener" />
                <MudNumericField T="int" @bind-Value="_settings.ApiId" Label="API ID" Variant="Variant.Outlined" Class="mt-2" HideSpinButtons="true" />
                <MudTextField T="string" @bind-Value="_settings.ApiHash" Label="API Hash" Variant="Variant.Outlined" Class="mt-2" InputType="InputType.Password" />
                <MudTextField T="string" @bind-Value="_settings.PhoneNumber" Label="Phone Number (international, e.g. +919999999999)"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudTextField T="string" @bind-Value="_settings.SessionPath" Label="Session file path" Variant="Variant.Outlined" Class="mt-2" />
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    Get your <b>API ID</b> and <b>API Hash</b> from <MudLink Href="https://my.telegram.org/apps" Target="_blank">my.telegram.org</MudLink>.
                    Credentials are encrypted at rest.
                </MudAlert>
                <MudStack Row="true" Class="mt-3" Spacing="2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAsync">Save</MudButton>
                    <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="ConnectAsync" Disabled="@(Manager.IsConnected || _state == TelegramConnectionState.Connecting || _state == TelegramConnectionState.AwaitingCode || _state == TelegramConnectionState.AwaitingPassword)">Connect</MudButton>
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="DisconnectAsync" Disabled="@(!Manager.IsConnected)">Disconnect</MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Trade Order Notifications</MudText>
                <MudTextField T="string" @bind-Value="_settings.OrderNotificationChannel" Label="Order Notifications Target Channel / Chat"
                              Placeholder="Leave blank for Saved Messages (to me), or enter channel title or username" HelperText="Notifications for Placed Orders &amp; Square-Offs will be sent here. Leave blank for 'Saved Messages'." Variant="Variant.Outlined" Class="mt-2" />
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    Trade order notifications (Placed Orders and Square-Offs with P&amp;L) will be sent to this destination (or Saved Messages if blank).
                </MudAlert>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Class="mt-3">Save Notification Settings</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Signal Message Forwarding / Copying</MudText>
                <MudTextField T="string" @bind-Value="_settings.DestinationChannel" Label="Signal Forwarding Destination Channel"
                              Placeholder="e.g. My Signal Copy Channel" HelperText="Channel where incoming signal messages are copied/forwarded." Variant="Variant.Outlined" Class="mt-2" />
                <MudSwitch T="bool" @bind-Value="_settings.ForwardOnlySignals" Color="Color.Primary" Label="Forward Only Valid Signals" Class="mt-2" />
                <MudSwitch T="bool" @bind-Value="_settings.ForwardAsCopy" Color="Color.Primary" Label="Forward as Clean Copy (Hide original author)" Class="mt-2" />
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    If configured, raw trading signals received from monitored channels will be copied to this destination channel.
                </MudAlert>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Class="mt-3">Save Forwarding Settings</MudButton>
            </MudPaper>
        </MudStack>
    </MudItem>

    <!-- Right Column: Channels to Monitor -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Channels to Monitor</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Add channels by their exact title (e.g. <em>Trade with Logic</em>) or @@username.
                    The bot only receives messages from channels your Telegram account has already joined.
                </MudText>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudTextField T="string" @bind-Value="_newChannel" Label="Channel title or username"
                                  Placeholder="Trade with Logic"
                                  Variant="Variant.Outlined" Class="flex-grow-1"
                                  OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await AddChannel(); })" />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddChannel">Add</MudButton>
                </MudStack>

                @if (_settings.Channels.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">No channels configured. The listener will not receive any signals.</MudAlert>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var ch in _settings.Channels)
                        {
                            <MudListItem T="string">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Class="flex-grow-1">@ch</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RemoveChannel(ch))" />
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }

                @if (Manager.IsConnected)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Or pick from channels you've joined:</MudText>
                    <MudStack Row="true" Spacing="2" Class="mb-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_refreshing"
                                   OnClick="RefreshAvailable">@(_refreshing ? "Refreshing..." : "Refresh list")</MudButton>
                    </MudStack>
                    @if (!AvailableToAdd.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            No broadcast channels found. Telegram sometimes refuses to return the joined-chat list
                            (500 RPC_CALL_FAIL); type the channel title or @@username above to add it manually.
                        </MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" Class="mud-elevation-1">
                            @foreach (var ac in AvailableToAdd)
                            {
                                <MudListItem T="string">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">
                                            @ac.Title @(string.IsNullOrEmpty(ac.Username) ? "" : $"({ac.Username})")
                                        </MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                                   OnClick="@(() => AddChannelDirect(ac.Title))">Add</MudButton>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                }
            </MudPaper>
        </MudStack>
    </MudItem>

</MudGrid>

@code {
    private TelegramSettings _settings = new();
    private TelegramConnectionState _state = TelegramConnectionState.Disconnected;
    private string _statusDescription = "Not connected";
    private string _code = string.Empty;
    private string _password = string.Empty;
    private string _newChannel = string.Empty;
    private IReadOnlyList<AvailableChannel> _available = Array.Empty<AvailableChannel>();
    private bool _refreshing;

    // Only show joined channels that are NOT already in the "Channels to Monitor" list.
    // A monitored entry (stored as a title or @username) matches an available channel by
    // either its Title or Username (case-insensitive).
    private IEnumerable<AvailableChannel> AvailableToAdd =>
        _available.Where(ac => !_settings.Channels.Any(c =>
            string.Equals(c, ac.Title, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrEmpty(ac.Username) && string.Equals(c, ac.Username, StringComparison.OrdinalIgnoreCase))));

    protected override async Task OnInitializedAsync()
    {
        _settings = await Manager.LoadAsync();
        _state = Manager.State;
        UpdateStatusDescription();
        Manager.StateChanged += OnStateChanged;

        if (Manager.IsConnected)
            _available = Manager.ListAvailableChannels();
    }

    public void Dispose()
    {
        Manager.StateChanged -= OnStateChanged;
    }

    private async void OnStateChanged(TelegramConnectionState s)
    {
        _state = s;
        UpdateStatusDescription();
        if (s == TelegramConnectionState.Connected)
            _available = Manager.ListAvailableChannels();
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateStatusDescription()
    {
        _statusDescription = _state switch
        {
            TelegramConnectionState.Disconnected => "Not connected. Configure credentials and click Connect.",
            TelegramConnectionState.Connecting => "Connecting to Telegram servers...",
            TelegramConnectionState.AwaitingCode => "Waiting for verification code sent to your Telegram app.",
            TelegramConnectionState.AwaitingPassword => "Waiting for your two-factor authentication password.",
            TelegramConnectionState.Connected => $"Connected as {Manager.Client.MeUsername}",
            TelegramConnectionState.Failed => "Connection failed. Check credentials and try again.",
            _ => string.Empty
        };
    }

    private static Color StateColor(TelegramConnectionState s) => s switch
    {
        TelegramConnectionState.Connected => Color.Success,
        TelegramConnectionState.Connecting => Color.Info,
        TelegramConnectionState.AwaitingCode or TelegramConnectionState.AwaitingPassword => Color.Warning,
        TelegramConnectionState.Failed => Color.Error,
        _ => Color.Default
    };

    private async Task SaveAsync()
    {
        try
        {
            await Manager.SaveAsync(_settings);
            Snackbar.Add("Telegram settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConnectAsync()
    {
        try
        {
            await Manager.SaveAsync(_settings);
            var ok = await Manager.ConnectAsync();
            if (!ok)
                Snackbar.Add("Cannot connect: check API ID, API Hash and phone number.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Connect failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DisconnectAsync()
    {
        await Manager.DisconnectAsync();
        Snackbar.Add("Disconnected from Telegram.", Severity.Info);
    }

    private void SubmitCode()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            Snackbar.Add("Enter the verification code first.", Severity.Warning);
            return;
        }
        Manager.SubmitCode(_code.Trim());
        _code = string.Empty;
    }

    private void SubmitPassword()
    {
        if (string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Enter the 2FA password first.", Severity.Warning);
            return;
        }
        Manager.SubmitPassword(_password);
        _password = string.Empty;
    }

    private async Task AddChannel()
    {
        var name = _newChannel?.Trim().TrimStart('@');
        if (string.IsNullOrWhiteSpace(name)) return;
        if (_settings.Channels.Any(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("Channel already added.", Severity.Info);
            return;
        }
        if (await PersistAddChannelAsync(name))
            _newChannel = string.Empty;
    }

    private async Task AddChannelDirect(string name)
    {
        if (_settings.Channels.Any(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("Channel already added.", Severity.Info);
            return;
        }
        await PersistAddChannelAsync(name);
    }

    // Adds a channel to the monitored list and persists immediately so the listener
    // starts monitoring it and the change is saved to the DB (consistent with removal).
    private async Task<bool> PersistAddChannelAsync(string name)
    {
        _settings.Channels.Add(name);
        try
        {
            await Manager.SaveAsync(_settings);
            Snackbar.Add($"Now monitoring '{name}'.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            // Roll back the in-memory add so the UI stays consistent with the DB.
            _settings.Channels.RemoveAll(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase));
            Snackbar.Add($"Could not add channel: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private async Task RemoveChannel(string name)
    {
        var removed = _settings.Channels.RemoveAll(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase));
        if (removed == 0)
            return;

        try
        {
            // Persist immediately so the listener stops monitoring this channel and the
            // change is removed from the DB. It reappears under "channels you've joined"
            // automatically via the AvailableToAdd filter.
            await Manager.SaveAsync(_settings);
            Snackbar.Add($"Stopped monitoring '{name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            // Roll back the in-memory removal so the UI stays consistent with the DB.
            _settings.Channels.Add(name);
            Snackbar.Add($"Could not remove channel: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshAvailable()
    {
        _refreshing = true;
        try
        {
            // Re-query Telegram rather than re-reading the in-memory cache: when the initial
            // dialog fetch failed the cache is empty and a plain re-read would change nothing.
            _available = await Manager.RefreshAvailableChannelsAsync();

            if (_available.Count == 0)
            {
                Snackbar.Add("Telegram did not return any joined channels. Add the channel manually by title or @username.", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Found {_available.Count} joined channel(s).", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not refresh channel list: {ex.Message}", Severity.Error);
        }
        finally
        {
            _refreshing = false;
        }
    }
}
