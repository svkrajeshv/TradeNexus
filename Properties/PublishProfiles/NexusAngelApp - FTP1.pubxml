<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <ResourceId>/subscriptions/a5c95740-b819-4391-bd6a-437f9f20567b/resourceGroups/dev-api/providers/Microsoft.Web/sites/NexusAngelApp</ResourceId>
    <IsLinux>True</IsLinux>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://nexusangelapp.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>404ba3c3-69c5-21d2-cc35-c32cd8c8efb5</ProjectGuid>
    <publishUrl>ftps://waws-prod-pn1-053.ftp.azurewebsites.windows.net</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <FtpPassiveMode>true</FtpPassiveMode>
    <FtpSitePath>site/wwwroot</FtpSitePath>
    <UserName>NexusAngelApp\$NexusAngelApp</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>