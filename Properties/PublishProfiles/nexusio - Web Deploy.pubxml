<?xml version="1.0" encoding="utf-8"?>
<!--
This file is used by the publish/package process of your Web project. You can customize the behavior of this process
by editing this MSBuild file. In order to learn more about this please visit https://go.microsoft.com/fwlink/?LinkID=208121. 
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/a5c95740-b819-4391-bd6a-437f9f20567b/resourceGroups/NexusApp-rg/providers/Microsoft.Web/sites/nexusio</ResourceId>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://nexusio.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>404ba3c3-69c5-21d2-cc35-c32cd8c8efb5</ProjectGuid>
    <MSDeployServiceURL>nexusio.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>nexusio</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>$nexusio</UserName>
    <_SavePWD>true</_SavePWD>
    <_DestinationType>AzureWebSite</_DestinationType>
    <InstallAspNetCoreSiteExtension>false</InstallAspNetCoreSiteExtension>
  </PropertyGroup>
  <!--
    SkipExtraFilesOnServer is false, so Web Deploy tries to delete every server file
    that is not in the package. The Logs folder is excluded from the package (see
    NexusApp.csproj), and the current day's file is held open by the Serilog rolling
    file sink, so that delete fails and retries 10 times. Skip the folder outright:
    runtime logs are not deployment artifacts and must survive a publish.
  -->
  <ItemGroup>
    <MsDeploySkipRules Include="SkipLogsFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\Logs$</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipLogFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>\\Logs\\\\.*</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>