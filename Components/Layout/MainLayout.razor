@inherits LayoutComponentBase
@using MudBlazor
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.SignalR.Client
@using NexusApp.Telegram
@using NexusApp.Interfaces
@using NexusApp.Services
@inject TelegramManager TelegramMgr
@inject IBroker Broker
@inject DataCleanupService Cleanup
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HubConnectionFactory HubFactory
@implements IAsyncDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface" Dense="true" Style="border-bottom: 1px solid var(--mud-palette-lines-default);">
        <MudIconButton Icon="@(_drawerOpen ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="mr-2">NexusApp</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.CleaningServices"
                 Color="Color.Warning"
                 Variant="Variant.Outlined"
                 Size="Size.Small"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 Disabled="_cleanupRunning"
                 Class="mr-1">
            <MudMenuItem Icon="@Icons.Material.Filled.HistoryToggleOff"
                         OnClick="@(() => RunCleanupAsync(false))">
                Clean previous-day data
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever"
                         IconColor="Color.Error"
                         OnClick="@(() => RunCleanupAsync(true))">
                Clean ALL data
            </MudMenuItem>
        </MudMenu>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       OnClick="ToggleTheme" />
        <MudChip T="string" Icon="@Icons.Material.Filled.Circle" Color="@(_brokerConnected ? Color.Success : Color.Error)"
                 Size="Size.Small" Class="px-2">
            <span class="d-none d-sm-inline">@(_brokerConnected ? "Broker Online" : "Broker Offline")</span>
        </MudChip>
        <MudChip T="string" Icon="@Icons.Material.Filled.Circle" Color="@TelegramChipColor()"
                 Size="Size.Small" Class="px-2">
            <span class="d-none d-sm-inline">@TelegramChipLabel()</span>
        </MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Size="Size.Small" OnClick="LogoutAsync" Class="ml-1" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    @* Horizontal/bottom padding only: the all-sides "pa-*" utilities would override the
       padding-top MudMainContent derives from the app bar height, letting page titles
       slide under the header. Top spacing is set explicitly from the same variable plus
       breathing room. NOTE: calc() requires whitespace around '+' - "+16px" is a parse
       error that silently drops the whole declaration. *@
    <MudMainContent Class="px-3 px-sm-5 pb-3 pb-sm-5"
                    Style="padding-top: calc(var(--mud-appbar-height) + 16px);">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _brokerConnected;
    private bool _cleanupRunning;
    private TelegramConnectionState _telegramState = TelegramConnectionState.Disconnected;
    private System.Threading.Timer? _pollTimer;
    private HubConnection? _hub;

    protected override void OnInitialized()
    {
        _telegramState = TelegramMgr.State;
        _brokerConnected = Broker.IsConnected;
        TelegramMgr.StateChanged += OnTelegramStateChanged;

        // Broker doesn't emit events yet; poll quickly so header reflects login promptly.
        _pollTimer = new System.Threading.Timer(_ =>
        {
            var updated = Broker.IsConnected;
            if (updated != _brokerConnected)
            {
                _brokerConnected = updated;
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hub is not null)
            return;

        // Subscribe to server-broadcast notifications so a flyout (snackbar) shows on
        // every page when orders execute / signals arrive / positions close.
        // Done after first render (not in OnInitialized) so the SignalR handshake never
        // blocks the layout render / page navigation.
        try
        {
            _hub = HubFactory.Create(Nav);

            _hub.On<JsonElement>("Notification", async payload =>
            {
                var (kind, title, body) = ParseNotification(payload);
                var severity = kind switch
                {
                    "error" => Severity.Error,
                    "order" => Severity.Success,
                    "signal" => Severity.Info,
                    _ => Severity.Normal
                };

                await InvokeAsync(() =>
                {
                    var text = string.IsNullOrWhiteSpace(body) ? title : $"{title} — {body}";
                    Snackbar.Add(text, severity);
                });

                // Best-effort browser notification + beep.
                try { await JS.InvokeVoidAsync("NexusApp.notify", title, body); } catch { }
                try { await JS.InvokeVoidAsync("NexusApp.beep"); } catch { }
            });

            // Trade-specific audio cues (paper vs live entry/exit, square-off, SL hit).
            _hub.On<JsonElement>("TradeSound", async payload =>
            {
                var sound = payload.ValueKind == JsonValueKind.Object &&
                            (payload.TryGetProperty("Sound", out var v) || payload.TryGetProperty("sound", out v))
                    ? v.GetString()
                    : null;

                if (string.IsNullOrWhiteSpace(sound))
                    return;

                try { await JS.InvokeVoidAsync("NexusApp.playSound", sound); } catch { }
            });

            // New trading signal parsed & received from Telegram
            _hub.On<JsonElement>("SignalReceived", async payload =>
            {
                var (requiresManual, channel, description) = ParseSignalReceived(payload);

                var channelBadge = !string.IsNullOrWhiteSpace(channel) ? $"[{channel}] " : "";
                var alertText = requiresManual
                    ? $"{channelBadge}{description} — action required"
                    : $"{channelBadge}{description} (auto)";

                await InvokeAsync(() =>
                {
                    Snackbar.Add(alertText, Severity.Info);
                });

                var notifTitle = !string.IsNullOrWhiteSpace(channel)
                    ? $"Signal: {channel}"
                    : "Trading Signal";

                try { await JS.InvokeVoidAsync("NexusApp.notify", notifTitle, $"{description} ({(requiresManual ? "action required" : "auto")})"); } catch { }
                try { await JS.InvokeVoidAsync("NexusApp.playSound", requiresManual ? "signal-manual" : "signal-auto"); } catch { }
            });

            await _hub.StartAsync();
        }
        catch { /* hub is best-effort */ }
    }

    private static (bool RequiresManual, string Channel, string Description) ParseSignalReceived(JsonElement payload)
    {
        if (payload.ValueKind != JsonValueKind.Object)
            return (false, string.Empty, "New signal received");

        string Get(string name1, string name2)
        {
            if (payload.TryGetProperty(name1, out var v) || payload.TryGetProperty(name2, out v))
            {
                return v.ValueKind switch
                {
                    JsonValueKind.String => v.GetString() ?? string.Empty,
                    JsonValueKind.Number => v.ToString(),
                    _ => v.ToString()
                };
            }
            return string.Empty;
        }

        var requiresManual = false;
        if (payload.TryGetProperty("RequiresManualAction", out var rm) || payload.TryGetProperty("requiresManualAction", out rm))
        {
            requiresManual = rm.ValueKind == JsonValueKind.True;
        }

        var channel = Get("ChannelName", "channelName");
        var actionRaw = Get("Action", "action");
        var index = Get("Index", "index");
        var strike = Get("Strike", "strike");
        var optType = Get("OptionType", "optionType");
        var entry = Get("EntryPrice", "entryPrice");

        var action = actionRaw switch
        {
            "0" => "BUY",
            "1" => "SELL",
            _ => actionRaw.ToUpperInvariant()
        };

        var desc = !string.IsNullOrWhiteSpace(index)
            ? $"{action} {index} {strike} {optType} @ {entry}".Trim()
            : "New signal received";

        return (requiresManual, channel, desc);
    }

    private static (string Kind, string Title, string Body) ParseNotification(JsonElement payload)
    {
        string Get(string name) =>
            payload.ValueKind == JsonValueKind.Object && payload.TryGetProperty(name, out var v)
                ? v.GetString() ?? string.Empty
                : string.Empty;

        return (Get("Kind"), Get("Title"), Get("Body"));
    }

    private async void OnTelegramStateChanged(TelegramConnectionState s)
    {
        _telegramState = s;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        TelegramMgr.StateChanged -= OnTelegramStateChanged;
        _pollTimer?.Dispose();
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private async Task OnCleanupClickedAsync() => await RunCleanupAsync(false);

    private async Task RunCleanupAsync(bool allData)
    {
        var message = allData
            ? "Clean ALL trading data?\n\nThis will permanently delete every signal, order, position, audit log, watchlist item and rolled log file. This cannot be undone."
            : "Clean previous-day data?\n\nThis will permanently delete signals, orders, positions, audit logs and rolled log files from before today. Today's data is preserved.";

        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm", message);
        }
        catch (JSDisconnectedException) { return; }
        catch (TaskCanceledException) { return; }

        if (!confirmed) return;

        _cleanupRunning = true;
        StateHasChanged();

        DataCleanupService.CleanupResult? result = null;
        try
        {
            result = await Cleanup.CleanupAsync(allData: allData);
        }
        catch (Exception ex)
        {
            try { Snackbar.Add($"Cleanup failed: {ex.Message}", Severity.Error); } catch { }
            _cleanupRunning = false;
            StateHasChanged();
            return;
        }

        try
        {
            Snackbar.Add(
                $"Cleanup done — signals: {result.SignalsRemoved}, orders: {result.OrdersRemoved}, positions: {result.PositionsRemoved}, audits: {result.AuditLogsRemoved}, logs: {result.LogFilesRemoved}",
                Severity.Success);
        }
        catch { /* snackbar not critical */ }

        // Give the MudMenu a moment to close & the snackbar to render before the
        // navigation tears down the circuit — otherwise MudMenu's post-click
        // focus JS interop throws JSDisconnectedException.
        await Task.Delay(300);

        _cleanupRunning = false;
        try
        {
            // forceLoad=true triggers a full page reload so every page re-queries the DB.
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception) { /* navigation always throws on server-side; swallow */ }
    }

    private Color TelegramChipColor() => _telegramState switch
    {
        TelegramConnectionState.Connected => Color.Success,
        TelegramConnectionState.Connecting => Color.Info,
        TelegramConnectionState.AwaitingCode or TelegramConnectionState.AwaitingPassword => Color.Warning,
        TelegramConnectionState.Failed => Color.Error,
        _ => Color.Warning
    };

    private string TelegramChipLabel() => _telegramState switch
    {
        TelegramConnectionState.Connected => "Telegram Live",
        TelegramConnectionState.Connecting => "Telegram Connecting",
        TelegramConnectionState.AwaitingCode => "Telegram Awaiting Code",
        TelegramConnectionState.AwaitingPassword => "Telegram Awaiting 2FA",
        TelegramConnectionState.Failed => "Telegram Failed",
        _ => "Telegram Idle"
    };

    private void LogoutAsync()
    {
        // Full-page navigation to the logout endpoint so the server can clear the
        // auth cookie via HttpContext.SignOutAsync (cannot be done from a circuit).
        Nav.NavigateTo("/auth/logout", forceLoad: true);
    }

    // A muted, high-contrast dark theme suited to trading dashboards.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563eb",
            Secondary = "#0ea5e9",
            Tertiary = "#f59e0b",
            AppbarBackground = "#0f172a",
            AppbarText = "#f8fafc",
            DrawerBackground = "#ffffff",
            DrawerText = "#1e293b",
            DrawerIcon = "#475569",
            Background = "#e2e8f0",
            Surface = "#ffffff",
            Success = "#16a34a",
            Error = "#dc2626",
            Warning = "#d97706",
            Info = "#0284c7",
            TextPrimary = "#0f172a",
            TextSecondary = "#64748b",
            LinesDefault = "#cbd5e1",
            TableLines = "#e2e8f0",
            Divider = "#cbd5e1"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#3b82f6",
            Secondary = "#38bdf8",
            Tertiary = "#fbbf24",
            AppbarBackground = "#0f172a",
            AppbarText = "#f8fafc",
            DrawerBackground = "#1e293b",
            DrawerText = "#e2e8f0",
            DrawerIcon = "#94a3b8",
            Background = "#0f172a",
            Surface = "#1e293b",
            Success = "#22c55e",
            Error = "#ef4444",
            Warning = "#f59e0b",
            Info = "#38bdf8",
            TextPrimary = "#f8fafc",
            TextSecondary = "#94a3b8",
            LinesDefault = "#334155",
            TableLines = "#334155",
            Divider = "#334155"
        }
    };
}
