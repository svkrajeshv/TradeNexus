@page "/accounts"
@using MudBlazor
@using NexusApp.Interfaces
@using NexusApp.Infrastructure
@using NexusApp.Brokers.AngelOne
@using Microsoft.Extensions.DependencyInjection
@inject ITradingAccountService AccountService
@inject ISettingsService SettingsService
@inject IBroker Broker
@inject NexusApp.Brokers.AngelOne.AngelOneApiClient AngelApiClient
@inject NexusApp.Brokers.AliceBlue.AliceBlueApiClient AliceApiClient
@inject AngelInstrumentMaster InstrumentMaster
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider

<PageTitle>NexusApp - Trading Accounts</PageTitle>

<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Trading Accounts</MudText>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">Add</MudButton>
</MudStack>

<MudPaper Class="pa-2 pa-sm-4" Elevation="2">
    <MudTable Items="_accounts" HorizontalScrollbar="true" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Broker</MudTh>
            <MudTh>Client ID</MudTh>
            <MudTh>Enabled</MudTh>
            <MudTh>Default</MudTh>
            <MudTh>Max Loss</MudTh>
            <MudTh>Max Profit</MudTh>
            <MudTh>Max Trades</MudTh>
            <MudTh>Max Positions</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.BrokerType</MudTd>
            <MudTd>@context.ClientId</MudTd>
            <MudTd><MudSwitch T="bool" Value="@context.IsEnabled" ValueChanged="@(v => ToggleEnabled(context, v))" Color="Color.Success" /></MudTd>
            <MudTd>
                <MudIconButton Icon="@(context.IsDefault ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                               Color="@(context.IsDefault ? Color.Warning : Color.Default)"
                               OnClick="@(() => SetAsDefaultAsync(context.Id))"
                               Disabled="@context.IsDefault"
                               Size="Size.Small" />
            </MudTd>
            <MudTd>@context.DailyMaxLoss</MudTd>
            <MudTd>@context.DailyMaxProfit</MudTd>
            <MudTd>@context.MaxTradesPerDay</MudTd>
            <MudTd>@context.MaxOpenPositions</MudTd>
            <MudTd>
                <MudStack Row="true" Wrap="Wrap.NoWrap" Spacing="0" AlignItems="AlignItems.Center">
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Login"
                               OnClick="@(() => LoginAccountAsync(context))">
                        Login
                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => OpenEditDialogAsync(context))">
                        Edit
                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.VpnKey"
                               OnClick="@(() => ConfigureApiAsync(context))">
                        API
                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               Disabled="@context.IsDefault"
                               OnClick="@(() => DeleteAccountAsync(context))">
                        Delete
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_selectedAccount is not null)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">@_selectedAccount.BrokerType API Login - @_selectedAccount.Name</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="API Key" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_apiKey" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Client ID" Variant="Variant.Outlined" @bind-Value="_apiClientId" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Password / PIN" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_apiPassword" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="TOTP (6-digit) or TOTP Secret (Base32)"
                              HelperText="You can paste QR secret once; app auto-generates current TOTP."
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              @bind-Value="_apiTotp" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="API URL" Variant="Variant.Outlined" @bind-Value="_apiUrl" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="WebSocket URL (optional)" Variant="Variant.Outlined" @bind-Value="_wsUrl" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-3" Spacing="2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveApiConfigAsync">Save API Config</MudButton>
            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="TestApiLoginAsync">Test API Login</MudButton>
            <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="ClearSelection">Close</MudButton>
        </MudStack>
    }
</MudPaper>

@if (_showAddDialog)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="1500">
        <MudPaper Class="pa-4 mx-auto mt-8" Style="max-width:760px; width:95%;">
            <MudText Typo="Typo.h6" Class="mb-2">@(_isEditMode ? "Edit Trading Account" : "Add Trading Account")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                @(_isEditMode ? "Update account properties, broker type, and API parameters below." : "Login is validated with the selected broker before the account is saved.")
            </MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Account Name" Variant="Variant.Outlined" @bind-Value="_newName" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Broker Type" Variant="Variant.Outlined" @bind-Value="_newBrokerType">
                        <MudSelectItem Value="@("AngelOne")">AngelOne</MudSelectItem>
                        <MudSelectItem Value="@("AliceBlue")">AliceBlue</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="API Key" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_newApiKey" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Client ID" Variant="Variant.Outlined" @bind-Value="_newClientId" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Password / PIN" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_newPassword" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="TOTP (6-digit) or Secret (Base32)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  @bind-Value="_newTotp" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="API URL" Variant="Variant.Outlined" @bind-Value="_newApiUrl" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="WebSocket URL (optional)" Variant="Variant.Outlined" @bind-Value="_newWsUrl" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="decimal" Label="Daily Max Loss" Variant="Variant.Outlined" @bind-Value="_newDailyMaxLoss" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="decimal" Label="Daily Max Profit" Variant="Variant.Outlined" @bind-Value="_newDailyMaxProfit" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="int" Label="Max Trades/Day" Variant="Variant.Outlined" @bind-Value="_newMaxTrades" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="int" Label="Max Positions" Variant="Variant.Outlined" @bind-Value="_newMaxPositions" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="decimal" Label="Default Lots" Variant="Variant.Outlined" @bind-Value="_newDefaultLots" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSwitch T="bool" @bind-Value="_newIsEnabled" Color="Color.Success" Label="Enabled" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSwitch T="bool" @bind-Value="_newIsDefault" Color="Color.Warning" Label="Default" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Class="mt-3" Spacing="2">
                @if (_isEditMode)
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEditedAccountAsync">Save Changes</MudButton>
                }
                else
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ValidateAndCreateAccountAsync">Validate Login &amp; Save</MudButton>
                }
                <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="CloseAddDialog">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<TradingAccountDto> _accounts = new();
    private TradingAccountDto? _selectedAccount;
    private string _apiKey = string.Empty;
    private string _apiClientId = string.Empty;
    private string _apiPassword = string.Empty;
    private string _apiTotp = string.Empty;
    private string _apiUrl = "https://apiconnect.angelone.in";
    private string _wsUrl = string.Empty;
    private Dictionary<string, string> _settingsSnapshot = new();
    private bool _showAddDialog;
    private bool _isEditMode;
    private int _editingAccountId;
    private string _newName = string.Empty;
    private string _newBrokerType = "AngelOne";
    private string _newApiKey = string.Empty;
    private string _newClientId = string.Empty;
    private string _newPassword = string.Empty;
    private string _newTotp = string.Empty;
    private string _newApiUrl = "https://apiconnect.angelone.in";
    private string _newWsUrl = string.Empty;
    private bool _newIsEnabled = true;
    private bool _newIsDefault;
    private decimal _newDailyMaxLoss = 1000;
    private decimal _newDailyMaxProfit = 5000;
    private int _newMaxTrades = 10;
    private int _newMaxPositions = 5;
    private decimal _newDefaultLots = 1;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _accounts = await AccountService.GetAllAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleEnabled(TradingAccountDto acc, bool value)
    {
        acc.IsEnabled = value;
        await AccountService.UpdateAccountAsync(acc.Id, acc);
        Snackbar.Add($"{acc.Name} {(value ? "enabled" : "disabled")}", Severity.Info);
    }

    private void OpenAddDialog()
    {
        _newName = $"Account {_accounts.Count + 1}";
        _newBrokerType = "AngelOne";
        _newApiKey = string.Empty;
        _newClientId = string.Empty;
        _newPassword = string.Empty;
        _newTotp = string.Empty;
        _newApiUrl = "https://apiconnect.angelone.in";
        _newWsUrl = string.Empty;
        _newIsEnabled = true;
        _newIsDefault = false;
        _newDailyMaxLoss = 1000;
        _newDailyMaxProfit = 5000;
        _newMaxTrades = 10;
        _newMaxPositions = 5;
        _newDefaultLots = 1;
        _isEditMode = false;
        _editingAccountId = 0;
        _showAddDialog = true;
    }

    private async Task OpenEditDialogAsync(TradingAccountDto acc)
    {
        _isEditMode = true;
        _editingAccountId = acc.Id;
        _newName = acc.Name;
        _newBrokerType = acc.BrokerType;
        _newClientId = acc.ClientId;
        _newDailyMaxLoss = acc.DailyMaxLoss;
        _newDailyMaxProfit = acc.DailyMaxProfit;
        _newMaxTrades = acc.MaxTradesPerDay;
        _newMaxPositions = acc.MaxOpenPositions;
        _newDefaultLots = acc.DefaultQuantity;
        _newIsEnabled = acc.IsEnabled;
        _newIsDefault = acc.IsDefault;

        _settingsSnapshot = await SettingsService.GetAllSettingsAsync();
        _newApiKey = ReadFromSnapshot(acc.BrokerType, acc.Id, "ApiKey", decrypt: false);
        _newPassword = ReadFromSnapshot(acc.BrokerType, acc.Id, "Password", decrypt: true);
        _newTotp = ReadFromSnapshot(acc.BrokerType, acc.Id, "Totp", decrypt: true);
        _newApiUrl = ReadFromSnapshot(acc.BrokerType, acc.Id, "ApiUrl", decrypt: false);
        _newWsUrl = ReadFromSnapshot(acc.BrokerType, acc.Id, "WebSocketUrl", decrypt: false);

        if (string.IsNullOrWhiteSpace(_newApiUrl))
            _newApiUrl = "https://apiconnect.angelone.in";

        _showAddDialog = true;
    }

    private async Task SaveEditedAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newClientId))
        {
            Snackbar.Add("Name and Client ID are required.", Severity.Warning);
            return;
        }

        try
        {
            var dto = new TradingAccountDto
            {
                Id = _editingAccountId,
                Name = (_newName ?? string.Empty).Trim(),
                BrokerType = _newBrokerType,
                ClientId = (_newClientId ?? string.Empty).Trim(),
                IsEnabled = _newIsEnabled,
                IsDefault = _newIsDefault,
                DailyMaxLoss = _newDailyMaxLoss,
                DailyMaxProfit = _newDailyMaxProfit,
                MaxTradesPerDay = _newMaxTrades,
                MaxOpenPositions = _newMaxPositions,
                DefaultQuantity = _newDefaultLots <= 0 ? 1 : _newDefaultLots
            };

            await AccountService.UpdateAccountAsync(_editingAccountId, dto);
            await WriteAccountSettingAsync(_newBrokerType, _editingAccountId, "ApiKey", (_newApiKey ?? string.Empty).Trim(), encrypt: false);
            await WriteAccountSettingAsync(_newBrokerType, _editingAccountId, "Password", _newPassword ?? string.Empty, encrypt: true);
            await WriteAccountSettingAsync(_newBrokerType, _editingAccountId, "Totp", _newTotp ?? string.Empty, encrypt: true);
            await WriteAccountSettingAsync(_newBrokerType, _editingAccountId, "ApiUrl", (_newApiUrl ?? string.Empty).Trim(), encrypt: false);
            await WriteAccountSettingAsync(_newBrokerType, _editingAccountId, "WebSocketUrl", (_newWsUrl ?? string.Empty).Trim(), encrypt: false);

            _showAddDialog = false;
            await LoadAsync();
            Snackbar.Add($"Trading account '{dto.Name}' updated successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update account: {ex.Message}", Severity.Error);
        }
    }

    private void CloseAddDialog() => _showAddDialog = false;

    private async Task ValidateAndCreateAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) ||
            string.IsNullOrWhiteSpace(_newClientId))
        {
            Snackbar.Add("Name and Client ID are required.", Severity.Warning);
            return;
        }

        var isPaper = string.Equals((_newClientId ?? string.Empty).Trim(), "PAPER", StringComparison.OrdinalIgnoreCase);

        if (!isPaper)
        {
            if (_newBrokerType == "AliceBlue")
            {
                if (string.IsNullOrWhiteSpace(_newApiKey))
                {
                    Snackbar.Add("Name, API Key and Client ID are required for AliceBlue.", Severity.Warning);
                    return;
                }
            }
            else if (string.IsNullOrWhiteSpace(_newApiKey) ||
                     string.IsNullOrWhiteSpace(_newPassword) ||
                     string.IsNullOrWhiteSpace(_newTotp))
            {
                Snackbar.Add("Name, API Key, Client ID, Password and TOTP code/secret are required.", Severity.Warning);
                return;
            }
        }

        if (_newBrokerType != "AngelOne" && _newBrokerType != "AliceBlue")
        {
            Snackbar.Add("Unsupported broker type.", Severity.Warning);
            return;
        }

        try
        {
            if (!isPaper)
            {
                var targetBroker = ServiceProvider.GetRequiredKeyedService<IBroker>(_newBrokerType);
                bool loginOk;
                if (_newBrokerType == "AngelOne")
                {
                    AngelApiClient.Configure((_newApiKey ?? string.Empty).Trim(), (_newApiUrl ?? string.Empty).Trim());
                    loginOk = await targetBroker.AuthenticateAsync((_newClientId ?? string.Empty).Trim(), _newPassword, (_newTotp ?? string.Empty).Trim());
                }
                else // AliceBlue
                {
                    AliceApiClient.Configure((_newApiKey ?? string.Empty).Trim(), string.IsNullOrWhiteSpace(_newApiUrl) ? null : (_newApiUrl ?? string.Empty).Trim());
                    loginOk = await targetBroker.AuthenticateAsync((_newClientId ?? string.Empty).Trim(), string.Empty, (_newApiKey ?? string.Empty).Trim());
                }

                if (!loginOk)
                {
                    Snackbar.Add("Login validation failed. Account not saved.", Severity.Error);
                    return;
                }
            }

            var dto = new TradingAccountDto
            {
                Name = (_newName ?? string.Empty).Trim(),
                BrokerType = _newBrokerType,
                ClientId = (_newClientId ?? string.Empty).Trim(),
                IsEnabled = _newIsEnabled,
                IsDefault = _newIsDefault,
                DailyMaxLoss = _newDailyMaxLoss,
                DailyMaxProfit = _newDailyMaxProfit,
                MaxTradesPerDay = _newMaxTrades,
                MaxOpenPositions = _newMaxPositions,
                DefaultQuantity = _newDefaultLots <= 0 ? 1 : _newDefaultLots
            };

            var accountId = await AccountService.CreateAccountAsync(dto);
            await WriteAccountSettingAsync(_newBrokerType, accountId, "ApiKey", (_newApiKey ?? string.Empty).Trim(), encrypt: false);
            await WriteAccountSettingAsync(_newBrokerType, accountId, "Password", _newPassword ?? string.Empty, encrypt: true);
            await WriteAccountSettingAsync(_newBrokerType, accountId, "Totp", _newTotp ?? string.Empty, encrypt: true);
            await WriteAccountSettingAsync(_newBrokerType, accountId, "ApiUrl", (_newApiUrl ?? string.Empty).Trim(), encrypt: false);
            await WriteAccountSettingAsync(_newBrokerType, accountId, "WebSocketUrl", (_newWsUrl ?? string.Empty).Trim(), encrypt: false);

            _showAddDialog = false;
            await LoadAsync();
            Snackbar.Add(isPaper ? "Paper trading account created successfully." : "Account created and login validated successfully.", Severity.Success);
            if (!isPaper && dto.BrokerType == "AngelOne")
            {
                _ = PreloadInstrumentMasterAsync(dto.Name);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create account: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfigureApiAsync(TradingAccountDto acc)
    {
        _selectedAccount = acc;
        _apiClientId = acc.ClientId;
        _settingsSnapshot = await SettingsService.GetAllSettingsAsync();

        _apiKey = ReadFromSnapshot(acc.BrokerType, acc.Id, "ApiKey", decrypt: false);
        _apiPassword = ReadFromSnapshot(acc.BrokerType, acc.Id, "Password", decrypt: true);
        _apiTotp = ReadFromSnapshot(acc.BrokerType, acc.Id, "Totp", decrypt: true);
        _apiUrl = ReadFromSnapshot(acc.BrokerType, acc.Id, "ApiUrl", decrypt: false);
        _wsUrl = ReadFromSnapshot(acc.BrokerType, acc.Id, "WebSocketUrl", decrypt: false);

        if (string.IsNullOrWhiteSpace(_apiUrl))
            _apiUrl = acc.BrokerType == "AliceBlue"
                ? "https://ant.aliceblueonline.com/rest/AliceBlueAPIService"
                : "https://apiconnect.angelone.in";
    }

    private void ClearSelection()
    {
        _selectedAccount = null;
        _apiKey = string.Empty;
        _apiClientId = string.Empty;
        _apiPassword = string.Empty;
        _apiTotp = string.Empty;
        _apiUrl = "https://apiconnect.angelone.in";
        _wsUrl = string.Empty;
    }

    private async Task SaveApiConfigAsync()
    {
        if (_selectedAccount is null)
            return;

        if (string.IsNullOrWhiteSpace(_apiClientId))
        {
            Snackbar.Add("Client ID is required.", Severity.Warning);
            return;
        }

        var isPaper = string.Equals((_apiClientId ?? string.Empty).Trim(), "PAPER", StringComparison.OrdinalIgnoreCase);

        // keep account row and API config in sync
        _selectedAccount.ClientId = (_apiClientId ?? string.Empty).Trim();
        await AccountService.UpdateAccountAsync(_selectedAccount.Id, _selectedAccount);

        await WriteAccountSettingAsync(_selectedAccount.BrokerType, _selectedAccount.Id, "ApiKey", (_apiKey ?? string.Empty).Trim(), encrypt: false);
        await WriteAccountSettingAsync(_selectedAccount.BrokerType, _selectedAccount.Id, "Password", _apiPassword ?? string.Empty, encrypt: true);
        await WriteAccountSettingAsync(_selectedAccount.BrokerType, _selectedAccount.Id, "Totp", _apiTotp ?? string.Empty, encrypt: true);
        await WriteAccountSettingAsync(_selectedAccount.BrokerType, _selectedAccount.Id, "ApiUrl", (_apiUrl ?? string.Empty).Trim(), encrypt: false);
        await WriteAccountSettingAsync(_selectedAccount.BrokerType, _selectedAccount.Id, "WebSocketUrl", (_wsUrl ?? string.Empty).Trim(), encrypt: false);

        await LoadAsync();
        Snackbar.Add(isPaper ? "Paper trading config saved." : $"{_selectedAccount.BrokerType} API config saved.", Severity.Success);
    }

    private async Task TestApiLoginAsync()
    {
        if (_selectedAccount is null)
            return;

        var isPaper = string.Equals((_apiClientId ?? string.Empty).Trim(), "PAPER", StringComparison.OrdinalIgnoreCase);
        if (isPaper)
        {
            Snackbar.Add("Paper Trading API login successful (Simulated) — Broker Online!", Severity.Success);
            _ = PreloadInstrumentMasterAsync(_selectedAccount.Name);
            return;
        }

        if (string.IsNullOrWhiteSpace(_apiClientId))
        {
            Snackbar.Add("Client ID is required for login test.", Severity.Warning);
            return;
        }

        var brokerTypeForCheck = _selectedAccount?.BrokerType ?? "AngelOne";
        if (brokerTypeForCheck == "AliceBlue")
        {
            if (string.IsNullOrWhiteSpace(_apiKey))
            {
                Snackbar.Add("Client ID and API Key are required for AliceBlue login test.", Severity.Warning);
                return;
            }
        }
        else if (string.IsNullOrWhiteSpace(_apiPassword) || string.IsNullOrWhiteSpace(_apiTotp))
        {
            Snackbar.Add("Client ID, Password and TOTP code/secret are required for login test.", Severity.Warning);
            return;
        }

        try
        {
            var brokerType = _selectedAccount?.BrokerType ?? "AngelOne";
            var targetBroker = ServiceProvider.GetRequiredKeyedService<IBroker>(brokerType);

            bool ok;
            if (brokerType == "AngelOne")
            {
                AngelApiClient.Configure((_apiKey ?? string.Empty).Trim(), (_apiUrl ?? string.Empty).Trim());
                ok = await targetBroker.AuthenticateAsync(
                    (_apiClientId ?? string.Empty).Trim(),
                    _apiPassword,
                    (_apiTotp ?? string.Empty).Trim());
            }
            else if (brokerType == "AliceBlue")
            {
                AliceApiClient.Configure((_apiKey ?? string.Empty).Trim(), string.IsNullOrWhiteSpace(_apiUrl) ? null : (_apiUrl ?? string.Empty).Trim());
                ok = await targetBroker.AuthenticateAsync(
                    (_apiClientId ?? string.Empty).Trim(),
                    string.Empty,
                    (_apiKey ?? string.Empty).Trim());
            }
            else
            {
                ok = await targetBroker.AuthenticateAsync(
                    (_apiClientId ?? string.Empty).Trim(),
                    _apiPassword,
                    (_apiTotp ?? string.Empty).Trim());
            }

            Snackbar.Add(ok ? $"{brokerType} API login successful — Broker Online!" : $"{brokerType} API login failed.", ok ? Severity.Success : Severity.Error);
            if (ok && brokerType == "AngelOne") _ = PreloadInstrumentMasterAsync(_selectedAccount!.Name);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login test failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoginAccountAsync(TradingAccountDto account)
    {
        var isPaper = string.Equals((account.ClientId ?? string.Empty).Trim(), "PAPER", StringComparison.OrdinalIgnoreCase);
        if (isPaper)
        {
            Snackbar.Add($"Login successful for {account.Name} (Paper Trading Mode) — Broker Online!", Severity.Success);
            _ = PreloadInstrumentMasterAsync(account.Name);
            return;
        }

        try
        {
            var settings = await SettingsService.GetAllSettingsAsync();
            var apiKey = ReadFromMap(settings, account.BrokerType, account.Id, "ApiKey", decrypt: false);
            var password = ReadFromMap(settings, account.BrokerType, account.Id, "Password", decrypt: true);
            var totp = ReadFromMap(settings, account.BrokerType, account.Id, "Totp", decrypt: true);
            var apiUrl = ReadFromMap(settings, account.BrokerType, account.Id, "ApiUrl", decrypt: false);

            if (string.IsNullOrWhiteSpace(account.ClientId) ||
                (account.BrokerType != "AliceBlue" &&
                 (string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(totp))) ||
                (account.BrokerType == "AliceBlue" && string.IsNullOrWhiteSpace(apiKey)))
            {
                Snackbar.Add($"Missing login configuration for {account.Name}. Click API and save credentials first.", Severity.Warning);
                return;
            }

            var targetBroker = ServiceProvider.GetRequiredKeyedService<IBroker>(account.BrokerType);

            bool ok;
            if (account.BrokerType == "AngelOne")
            {
                AngelApiClient.Configure((apiKey ?? string.Empty).Trim(), string.IsNullOrWhiteSpace(apiUrl) ? "https://apiconnect.angelone.in" : (apiUrl ?? string.Empty).Trim());
                ok = await targetBroker.AuthenticateAsync((account.ClientId ?? string.Empty).Trim(), password, (totp ?? string.Empty).Trim());
            }
            else if (account.BrokerType == "AliceBlue")
            {
                AliceApiClient.Configure((apiKey ?? string.Empty).Trim(), string.IsNullOrWhiteSpace(apiUrl) ? null : (apiUrl ?? string.Empty).Trim());
                ok = await targetBroker.AuthenticateAsync((account.ClientId ?? string.Empty).Trim(), string.Empty, (apiKey ?? string.Empty).Trim());
            }
            else
            {
                ok = await targetBroker.AuthenticateAsync((account.ClientId ?? string.Empty).Trim(), password, (totp ?? string.Empty).Trim());
            }

            if (ok)
            {
                Snackbar.Add($"Login successful for {account.Name}.", Severity.Success);
                if (account.BrokerType == "AngelOne")
                {
                    _ = PreloadInstrumentMasterAsync(account.Name);
                }
            }
            else
            {
                Snackbar.Add($"Login failed for {account.Name}.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login failed for {account.Name}: {ex.Message}", Severity.Error);
        }
    }

    private async Task PreloadInstrumentMasterAsync(string accountName)
    {
        // If it was already refreshed today, keep the in-memory copy — no need to
        // re-download on every login click.
        if (InstrumentMaster.IsLoadedToday)
        {
            Snackbar.Add($"Instrument master already refreshed today ({InstrumentMaster.Count:N0} contracts).", Severity.Info);
            return;
        }

        Snackbar.Add($"Refreshing Angel One instrument master (once per day)…", Severity.Info);

        try
        {
            // Clean + reload once per calendar day: drops the stale in-memory index,
            // deletes yesterday's disk cache and downloads a fresh master. Returns the
            // number of contracts actually loaded.
            var count = await Task.Run(() => InstrumentMaster.RefreshDailyAsync());
            await InvokeAsync(() =>
            {
                if (count > 0)
                {
                    Snackbar.Add(
                        $"Instrument master refreshed ({count:N0} contracts). Orders will now resolve instantly.",
                        Severity.Success);
                }
                else
                {
                    Snackbar.Add(
                        "Instrument master refresh returned 0 contracts. Check internet access to Angel One and try login again.",
                        Severity.Warning);
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
                Snackbar.Add($"Failed to load instrument master: {ex.Message}", Severity.Error));
        }
    }

    private async Task SetAsDefaultAsync(int accountId)
    {
        try
        {
            var ok = await AccountService.SetDefaultAccountAsync(accountId);
            if (ok)
            {
                Snackbar.Add("Default account updated.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Failed to update default account.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error setting default account: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAccountAsync(TradingAccountDto acc)
    {
        if (acc.IsDefault)
        {
            Snackbar.Add("Default account cannot be deleted.", Severity.Warning);
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete account '{acc.Name}'?");
        if (!ok) return;

        var deleted = await AccountService.DeleteAccountAsync(acc.Id);
        if (!deleted)
        {
            Snackbar.Add("Failed to delete account.", Severity.Error);
            return;
        }

        Snackbar.Add($"Deleted account: {acc.Name}", Severity.Success);
        await LoadAsync();
    }

    private string ReadFromSnapshot(string brokerType, int accountId, string keySuffix, bool decrypt)
    {
        _settingsSnapshot.TryGetValue($"{brokerType}.Account.{accountId}.{keySuffix}", out var raw);
        raw ??= string.Empty;
        if (!decrypt || string.IsNullOrWhiteSpace(raw))
            return raw;
        return CredentialProtector.Unprotect(raw);
    }

    private static string ReadFromMap(Dictionary<string, string> map, string brokerType, int accountId, string keySuffix, bool decrypt)
    {
        map.TryGetValue($"{brokerType}.Account.{accountId}.{keySuffix}", out var raw);
        raw ??= string.Empty;
        if (!decrypt || string.IsNullOrWhiteSpace(raw))
            return raw;
        return CredentialProtector.Unprotect(raw);
    }

    private async Task WriteAccountSettingAsync(string brokerType, int accountId, string keySuffix, string value, bool encrypt)
    {
        var toSave = encrypt ? CredentialProtector.Protect(value ?? string.Empty) : value ?? string.Empty;
        await SettingsService.SetSettingAsync($"{brokerType}.Account.{accountId}.{keySuffix}", toSave);
    }
}
