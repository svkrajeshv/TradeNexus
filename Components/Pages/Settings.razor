@page "/settings"
@using MudBlazor
@using NexusApp.Components.Settings
@using NexusApp.Helpers
@using NexusApp.Interfaces
@using NexusApp.Models
@using NexusApp.Services
@inject ISettingsService SettingsService
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject McxToggle McxToggle

<PageTitle>NexusApp - Settings</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4 font-weight-bold">Settings</MudText>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" Class="mb-2">

<MudTabPanel Text="General" Icon="@Icons.Material.Filled.Tune">
<MudGrid Spacing="3">
    <!-- Left Column -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <!-- Trading Mode -->
            <MudPaper Class="pa-4 settings-card-blue" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Trading Mode</MudText>
                </MudStack>
                <MudSelect T="string" @bind-Value="_tradingMode" Label="Mode" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("manual")">Manual (confirm each trade)</MudSelectItem>
                    <MudSelectItem Value="@("auto")">Automatic (place immediately)</MudSelectItem>
                </MudSelect>
            </MudPaper>

            <!-- Default Order Size -->
            <MudPaper Class="pa-4 settings-card-purple" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6">Default Order Size</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Used as the pre-filled Lots value on every new signal. You can override per-signal on the Dashboard.
                </MudText>
                <MudNumericField T="int"
                                  @bind-Value="_defaultQuantity"
                                  Label="Default Lots per Order"
                                  HelperText="e.g. 1 lot = 75 qty for NIFTY, 30 for BANKNIFTY"
                                  Variant="Variant.Outlined"
                                  Min="1"
                                  Class="mb-3" />
            </MudPaper>

            <!-- Notifications -->
            <MudPaper Class="pa-4 settings-card-cyan" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Info" />
                    <MudText Typo="Typo.h6">Notifications</MudText>
                </MudStack>
                <MudSwitch T="bool" @bind-Value="_browserNotifications" Color="Color.Primary" Label="Browser notifications" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_soundAlerts" Color="Color.Primary" Label="Sound alerts" />
            </MudPaper>
        </MudStack>
    </MudItem>

    <!-- Right Column -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <!-- Admin Account Security -->
            <MudPaper Class="pa-4 settings-card-amber" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">Admin Account Security</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Update your application login credentials.
                </MudText>
                <MudTextField T="string" @bind-Value="_adminUsername" Label="Admin Username" Variant="Variant.Outlined" Class="mb-3" Immediate="true" />
                <MudTextField T="string"
                              @bind-Value="_adminPassword"
                              Label="New Admin Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showAdminPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showAdminPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showAdminPassword = !_showAdminPassword)"
                              HelperText="Leave blank to keep current password"
                              Class="mb-3"
                              Immediate="true" />
                <MudTextField T="string"
                              @bind-Value="_confirmAdminPassword"
                              Label="Confirm New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showAdminPassword ? InputType.Text : InputType.Password)"
                              HelperText="Re-enter new password to confirm"
                              Immediate="true" />
            </MudPaper>

            <!-- Data Retention -->
            <MudPaper Class="pa-4 settings-card-cyan" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" />
                    <MudText Typo="Typo.h6">Data Retention</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Durable P&amp;L history shown on the PNL Statements page is trimmed daily beyond this window.
                </MudText>
                <MudNumericField T="int"
                                  @bind-Value="_pnlHistoryRetentionDays"
                                  Label="P&amp;L History Retention (days)"
                                  HelperText="Delete P&L history older than this many days (0 = keep forever)"
                                  Variant="Variant.Outlined"
                                  Min="0" />
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>
</MudTabPanel>

<MudTabPanel Text="Equity" Icon="@Icons.Material.Filled.ShowChart">
    <MudPaper Class="pa-4 mb-3 settings-card-cyan" Elevation="2">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
            NSE/BSE index options (NFO &amp; BFO). Market hours 09:15-15:30 IST.
        </MudText>
    </MudPaper>
    <SegmentSettingsPanel Segment="MarketSegment.Equity" Lots="_lotConfigs" Profiles="_indexProfiles" />
</MudTabPanel>

<MudTabPanel Text="MCX" Icon="@Icons.Material.Filled.LocalGasStation">
    <MudPaper Class="pa-4 mb-3 settings-card-amber" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
            <MudIcon Icon="@Icons.Material.Filled.PowerSettingsNew" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Commodity (MCX) Trading</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Master switch. When off, MCX signals are neither parsed nor executed and commodity market hours are ignored by the pollers.
        </MudText>
        <MudSwitch T="bool" @bind-Value="_mcxEnabled" Color="Color.Warning" Label="Enable commodity (MCX) trading" />
    </MudPaper>
    <SegmentSettingsPanel Segment="MarketSegment.Commodity" Lots="_lotConfigs" Profiles="_indexProfiles" Enabled="_mcxEnabled" />
</MudTabPanel>

<MudTabPanel Text="Risk &amp; Execution" Icon="@Icons.Material.Filled.Shield">
<MudGrid Spacing="3">
    <!-- Left Column -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4 settings-card-red" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Error" />
                    <MudText Typo="Typo.h6">Portfolio Risk Management (All Accounts)</MudText>
                </MudStack>
                <MudNumericField T="decimal" @bind-Value="_dailyMaxLoss" Label="Portfolio Daily Max Loss (₹) — All Accounts" HelperText="Combined daily loss threshold across all accounts (Live + Paper). 0 = disabled" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField T="decimal" @bind-Value="_dailyMaxProfit" Label="Portfolio Daily Max Profit (₹) — All Accounts" HelperText="Combined daily profit target across all accounts (Live + Paper). 0 = disabled" Variant="Variant.Outlined" Class="mb-3" />
                <MudSwitch T="bool" @bind-Value="_riskAutoSquareOffEnabled" Color="Color.Error" Label="Auto square-off positions when Risk Limits (Portfolio or Account) are hit" Class="mb-2" />
                <MudNumericField T="int" @bind-Value="_maxOpenPositions" Label="Max Open Positions" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField T="int" @bind-Value="_maxTradesPerDay" Label="Max Trades / Day" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField T="int"
                                  @bind-Value="_duplicateSignalCooldownMinutes"
                                  Label="Duplicate Signal Cooldown (minutes)"
                                  HelperText="Block repeat executions of the same contract for this many minutes (0 = disabled)"
                                  Variant="Variant.Outlined"
                                  Min="0"
                                  Class="mb-3" />
                <MudNumericField T="decimal"
                                 @bind-Value="_stopLossBuffer"
                                  Label="Stop-Loss Buffer (pts)"
                                 HelperText="Moves an already parsed signal stop-loss closer to entry; does not create a missing stop-loss. 0 = disabled"
                                 Variant="Variant.Outlined"
                                 Min="0m" />
            </MudPaper>

            <!-- Trading Hours & Auto Square-Off -->
            <MudPaper Class="pa-4 settings-card-blue" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Trading Hours &amp; Square-Off</MudText>
                </MudStack>
                <MudSwitch T="bool" @bind-Value="_allowAfterMarketHours" Color="Color.Warning" Label="Allow orders after market hours (testing)" Class="mb-2" />
                <MudSwitch T="bool" @bind-Value="_killSwitch" Color="Color.Error" Label="Emergency Kill Switch (block all trades)" Class="mb-2" />
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Auto Square-Off</MudText>
                <MudSwitch T="bool" @bind-Value="_autoSquareOffEnabled" Color="Color.Error" Label="Enable Auto Square-Off" Class="mb-2" />
                <MudTextField T="string" @bind-Value="_autoSquareOffTime" Label="Auto Square-Off Time (24h IST, e.g. 15:10)" Variant="Variant.Outlined" HelperText="All open positions are closed automatically at this IST time each day" />
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Signals by Time</MudText>
                <MudSwitch T="bool" @bind-Value="_signalTimeWindowEnabled" Color="Color.Primary" Label="Only execute signals within trading window" Class="mb-2" />
                <MudTextField T="string" @bind-Value="_signalTimeWindowStart" Label="Signal Start Time (24h IST, e.g. 09:15)" Variant="Variant.Outlined" Class="mb-3" HelperText="Signals received before this IST time are skipped" />
                <MudTextField T="string" @bind-Value="_signalTimeWindowEnd" Label="Signal End Time (24h IST, e.g. 15:00)" Variant="Variant.Outlined" HelperText="Signals received after this IST time are skipped" />
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Slippage Guard</MudText>
                <MudSwitch T="bool" @bind-Value="_slippageGuardEnabled" Color="Color.Warning" Label="Reject live orders on excessive slippage" Class="mb-2" />
                <MudNumericField T="decimal"
                                  @bind-Value="_maxSlippagePercent"
                                  Label="Max Slippage (%)"
                                  HelperText="Reject order if CMP has moved adversely beyond this % from signal entry"
                                  Variant="Variant.Outlined"
                                  Min="0m" />
            </MudPaper>
        </MudStack>
    </MudItem>

    <!-- Right Column -->
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <!-- Entry Trigger & Price Offsets -->
            <MudPaper Class="pa-4 settings-card-purple" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6">Entry Trigger &amp; Price Offsets</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Configure breakout trigger conditions and limit order retracement buffers.
                </MudText>
                <MudSelect T="string" @bind-Value="_orderVariety" Label="Order Type" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem Value="@("Robo")">Robo / Bracket Order (SL + Target auto-managed by broker)</MudSelectItem>
                    <MudSelectItem Value="@("Limit")">Plain Limit Order (manual SL/target management)</MudSelectItem>
                    <MudSelectItem Value="@("Market")">Market Order (immediate execution at live CMP)</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_enableEntryCrossingTrigger" Color="Color.Primary" Label="Enable Entry Price Crossing Trigger" Class="mb-3" />
                <MudSwitch T="bool" @bind-Value="_requireEntryCrossFromBelow" Color="Color.Primary" Label="Require Cross From Below" Class="mb-3" />
                <MudNumericField T="decimal"
                                  @bind-Value="_entryPriceOffset"
                                  Label="Entry Price Offset (pts)"
                                  HelperText="Adjusts a non-market limit order to (Entry - Offset); 0 = no adjustment"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />
                <MudNumericField T="decimal"
                                  @bind-Value="_targetPriceOffset"
                                  Label="Target Price Offset (pts)"
                                  HelperText="Adjusts numeric targets supplied by the signal to (Target - Offset); 0 = no adjustment"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Signal Defaults (Global Fallback)</MudText>
                <MudNumericField T="decimal"
                                  @bind-Value="_defaultTargetPoints"
                                   Label="Default Target (pts)"
                                  HelperText="Creates a target this many points from entry when the signal target is missing or non-numeric"
                                  Variant="Variant.Outlined"
                                  Min="0m"
                                  Class="mb-3" />
                <MudNumericField T="decimal"
                                  @bind-Value="_defaultStopLossPoints"
                                   Label="Default Stop-Loss (pts)"
                                  HelperText="Creates a stop-loss this many points below entry when the signal SL is missing or non-numeric"
                                  Variant="Variant.Outlined"
                                  Min="0m"
                                  Class="mb-3" />
                <MudNumericField T="decimal"
                                  @bind-Value="_exitPriceOffset"
                                   Label="Exit Price Offset (pts)"
                                   HelperText="Paper trading only: adjusts the observed exit CMP adversely; live exits use the broker fill. 0 = no adjustment"
                                  Variant="Variant.Outlined"
                                  Class="mb-3"
                                  Min="0m" />
                @if (string.Equals(_orderVariety, "Robo", StringComparison.OrdinalIgnoreCase))
                {
                    <MudNumericField T="decimal"
                                      @bind-Value="_trailingStopLossPoints"
                                      Label="Trailing Stop-Loss (pts)"
                                      HelperText="Auto-trail SL by this many points as price moves favorably (0 = disabled)"
                                      Variant="Variant.Outlined"
                                      Min="0m"
                                      Class="mb-3" />
                }
                <MudDivider Class="my-3" />
                <MudNumericField T="int"
                                  @bind-Value="_pendingOrderTimeoutMinutes"
                                  Label="Pending Order Auto-Cancel (mins)"
                                  HelperText="Cancel unfilled limit orders after this many minutes (0 = disabled)"
                                  Variant="Variant.Outlined"
                                  Min="0" />
            </MudPaper>

            <!-- Segment-Based Risk & Target Defaults -->
            <MudPaper Class="pa-4 settings-card-blue" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Target &amp; Stop-Loss Mode</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Chooses how the per-contract levels on the Equity and MCX tabs are applied.
                </MudText>
                <MudSelect T="string" @bind-Value="_riskSlMode" Label="Calculation Mode" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Points")">Absolute Points (Fixed pts from entry)</MudSelectItem>
                    <MudSelectItem Value="@("Percent")">Percentage of Premium (% from entry)</MudSelectItem>
                </MudSelect>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>
</MudTabPanel>

</MudTabs>

<MudStack Row="true" Class="mt-4" Spacing="2">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save Settings</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Reload</MudButton>
</MudStack>

@code {
    private string _tradingMode = "manual";
    private int _defaultQuantity = 1;

    // Per-index lot overrides
    private List<LotConfigVm> _lotConfigs =
    [
        new() { Underlying = "NIFTY",      Segment = MarketSegment.Equity },
        new() { Underlying = "BANKNIFTY",  Segment = MarketSegment.Equity },
        new() { Underlying = "FINNIFTY",   Segment = MarketSegment.Equity },
        new() { Underlying = "MIDCPNIFTY", Segment = MarketSegment.Equity },
        new() { Underlying = "SENSEX",     Segment = MarketSegment.Equity },
        new() { Underlying = "BANKEX",     Segment = MarketSegment.Equity },
        new() { Underlying = "CRUDEOIL",   Segment = MarketSegment.Commodity },
        new() { Underlying = "NATURALGAS", Segment = MarketSegment.Commodity },
        new() { Underlying = "GOLD",       Segment = MarketSegment.Commodity },
        new() { Underlying = "SILVER",     Segment = MarketSegment.Commodity },
    ];

    private decimal _dailyMaxLoss = 1000;
    private decimal _dailyMaxProfit = 5000;
    private bool _riskAutoSquareOffEnabled = false;
    private int _maxOpenPositions = 5;
    private int _maxTradesPerDay = 10;
    private decimal _stopLossBuffer = 0;
    private bool _browserNotifications = true;
    private bool _soundAlerts = true;
    private bool _killSwitch = false;
    private bool _allowAfterMarketHours = false;
    private bool _autoSquareOffEnabled = false;
    private string _autoSquareOffTime = "15:10";
    private bool _signalTimeWindowEnabled = false;
    private string _signalTimeWindowStart = "09:15";
    private string _signalTimeWindowEnd = "15:00";
    private bool _slippageGuardEnabled = false;
    private decimal _maxSlippagePercent = 1.0m;
    private bool _enableEntryCrossingTrigger = true;
    private bool _requireEntryCrossFromBelow = true;
    private decimal _entryPriceOffset = 10.0m;
    private decimal _targetPriceOffset = 10.0m;
    private decimal _defaultTargetPoints = 20.0m;
    private decimal _defaultStopLossPoints = 50.0m;
    private decimal _exitPriceOffset = 0m;
    private int _pendingOrderTimeoutMinutes = 5;
    private int _duplicateSignalCooldownMinutes = 2;
    private int _pnlHistoryRetentionDays = 90;
    private string _orderVariety = "Robo";
    private decimal _trailingStopLossPoints = 0m;
    private string _riskSlMode = "Points";
    private bool _mcxEnabled = false;

    private List<IndexRiskProfileVm> _indexProfiles =
    [
        new() { Index = "NIFTY",      DefaultSlPoints = 20, DefaultTargetPoints = 35,  OverrideTargetPoints = 15, SlPercent = 18, TargetPercent = 35 },
        new() { Index = "BANKNIFTY",  DefaultSlPoints = 40, DefaultTargetPoints = 70,  OverrideTargetPoints = 15, SlPercent = 20, TargetPercent = 40 },
        new() { Index = "FINNIFTY",   DefaultSlPoints = 20, DefaultTargetPoints = 35,  OverrideTargetPoints = 15, SlPercent = 18, TargetPercent = 35 },
        new() { Index = "MIDCPNIFTY", DefaultSlPoints = 15, DefaultTargetPoints = 25,  OverrideTargetPoints = 15, SlPercent = 15, TargetPercent = 30 },
        new() { Index = "SENSEX",     DefaultSlPoints = 80, DefaultTargetPoints = 140, OverrideTargetPoints = 15, SlPercent = 25, TargetPercent = 50 },
        new() { Index = "BANKEX",     DefaultSlPoints = 90, DefaultTargetPoints = 150, OverrideTargetPoints = 15, SlPercent = 25, TargetPercent = 50 },
        new() { Index = "CRUDEOIL",   Segment = MarketSegment.Commodity, DefaultSlPoints = 15, DefaultTargetPoints = 30,  OverrideTargetPoints = 15, SlPercent = 22, TargetPercent = 45 },
        new() { Index = "NATURALGAS", Segment = MarketSegment.Commodity, DefaultSlPoints = 5,  DefaultTargetPoints = 10,  OverrideTargetPoints = 15, SlPercent = 25, TargetPercent = 50 },
        new() { Index = "GOLD",       Segment = MarketSegment.Commodity, DefaultSlPoints = 60, DefaultTargetPoints = 120, OverrideTargetPoints = 15, SlPercent = 20, TargetPercent = 40 },
        new() { Index = "SILVER",     Segment = MarketSegment.Commodity, DefaultSlPoints = 50, DefaultTargetPoints = 100, OverrideTargetPoints = 15, SlPercent = 22, TargetPercent = 45 },
    ];

    private string _adminUsername = "admin";
    private string _adminPassword = "";
    private string _confirmAdminPassword = "";
    private bool _showAdminPassword = false;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _tradingMode = await SettingsService.GetSettingAsync<string>("TradingMode") ?? _tradingMode;
            var qty = await SettingsService.GetSettingAsync<int?>("DefaultQuantity"); if (qty.HasValue) _defaultQuantity = qty.Value;
 
            var mcx = await SettingsService.GetSettingAsync<bool?>("Mcx.Enabled");
            if (mcx.HasValue) _mcxEnabled = mcx.Value;

            foreach (var lot in _lotConfigs)
            {
                var lots = await SettingsService.GetSettingAsync<int?>($"Lots.{lot.Underlying}");
                if (lots.HasValue) lot.Lots = lots.Value;
            }
 
            var dml  = await SettingsService.GetSettingAsync<decimal?>("DailyMaxLoss");       if (dml.HasValue)  _dailyMaxLoss     = dml.Value;
            var dmp  = await SettingsService.GetSettingAsync<decimal?>("DailyMaxProfit");     if (dmp.HasValue)  _dailyMaxProfit   = dmp.Value;
            var rase = await SettingsService.GetSettingAsync<bool?>("RiskAutoSquareOffEnabled");
            if (rase.HasValue) _riskAutoSquareOffEnabled = rase.Value;
            var mop  = await SettingsService.GetSettingAsync<int?>("MaxOpenPositions");       if (mop.HasValue)  _maxOpenPositions  = mop.Value;
            var mtpd = await SettingsService.GetSettingAsync<int?>("MaxTradesPerDay");        if (mtpd.HasValue) _maxTradesPerDay   = mtpd.Value;
            var slb  = await SettingsService.GetSettingAsync<decimal?>("StopLossBuffer");     if (slb.HasValue)  _stopLossBuffer    = slb.Value;
            var ks   = await SettingsService.GetSettingAsync<bool?>("KillSwitch");
            if (ks.HasValue) _killSwitch = ks.Value;
            var amh = await SettingsService.GetSettingAsync<bool?>("AllowAfterMarketHours");
            if (amh.HasValue) _allowAfterMarketHours = amh.Value;
            var asoe = await SettingsService.GetSettingAsync<bool?>("AutoSquareOffEnabled");
            if (asoe.HasValue) _autoSquareOffEnabled = asoe.Value;
            _autoSquareOffTime = await SettingsService.GetSettingAsync<string>("AutoSquareOffTime") ?? "15:10";

            var stwe = await SettingsService.GetSettingAsync<bool?>("SignalTimeWindowEnabled");
            if (stwe.HasValue) _signalTimeWindowEnabled = stwe.Value;
            _signalTimeWindowStart = await SettingsService.GetSettingAsync<string>("SignalTimeWindowStart") ?? "09:15";
            _signalTimeWindowEnd = await SettingsService.GetSettingAsync<string>("SignalTimeWindowEnd") ?? "15:00";
            var sge = await SettingsService.GetSettingAsync<bool?>("SlippageGuardEnabled");
            if (sge.HasValue) _slippageGuardEnabled = sge.Value;
            var msp = await SettingsService.GetSettingAsync<decimal?>("MaxSlippagePercent");
            if (msp.HasValue) _maxSlippagePercent = msp.Value;

            var eect = await SettingsService.GetSettingAsync<bool?>("EnableEntryPriceCrossingTrigger");
            if (eect.HasValue) _enableEntryCrossingTrigger = eect.Value;
            var recfb = await SettingsService.GetSettingAsync<bool?>("RequireEntryCrossFromBelow");
            if (recfb.HasValue) _requireEntryCrossFromBelow = recfb.Value;
            var epo = await SettingsService.GetSettingAsync<decimal?>("EntryPriceOffset");
            if (epo.HasValue) _entryPriceOffset = epo.Value;
            var tpo = await SettingsService.GetSettingAsync<decimal?>("TargetPriceOffset");
            if (tpo.HasValue) _targetPriceOffset = tpo.Value;
            var dtp = await SettingsService.GetSettingAsync<decimal?>("DefaultTargetPoints");
            if (dtp.HasValue) _defaultTargetPoints = dtp.Value;
            var dsl = await SettingsService.GetSettingAsync<decimal?>("DefaultStopLossPoints");
            if (dsl.HasValue) _defaultStopLossPoints = dsl.Value;
            var xpo = await SettingsService.GetSettingAsync<decimal?>("ExitPriceOffset");
            if (xpo.HasValue) _exitPriceOffset = xpo.Value;
            var potm = await SettingsService.GetSettingAsync<int?>("PendingOrderTimeoutMinutes");
            if (potm.HasValue) _pendingOrderTimeoutMinutes = potm.Value;
            var dscm = await SettingsService.GetSettingAsync<int?>("DuplicateSignalCooldownMinutes");
            if (dscm.HasValue) _duplicateSignalCooldownMinutes = dscm.Value;
            var phrd = await SettingsService.GetSettingAsync<int?>("PnlHistoryRetentionDays");
            if (phrd.HasValue) _pnlHistoryRetentionDays = phrd.Value;
            _orderVariety = await SettingsService.GetSettingAsync<string>("OrderVariety") ?? "Robo";
            var tslp = await SettingsService.GetSettingAsync<decimal?>("TrailingStopLossPoints");
            if (tslp.HasValue) _trailingStopLossPoints = tslp.Value;

            _riskSlMode = await SettingsService.GetSettingAsync<string>("Risk.SlMode") ?? "Points";
            foreach (var profile in _indexProfiles)
            {
                var slPts = await SettingsService.GetSettingAsync<decimal?>($"SL.Points.{profile.Index}");
                if (slPts.HasValue) profile.DefaultSlPoints = slPts.Value;

                var tgtPts = await SettingsService.GetSettingAsync<decimal?>($"Target.Points.{profile.Index}");
                if (tgtPts.HasValue) profile.DefaultTargetPoints = tgtPts.Value;

                var overrideTgt = await SettingsService.GetSettingAsync<decimal?>($"Target.Override.{profile.Index}");
                if (overrideTgt.HasValue) profile.OverrideTargetPoints = overrideTgt.Value;

                var slPct = await SettingsService.GetSettingAsync<decimal?>($"SL.Percent.{profile.Index}");
                if (slPct.HasValue) profile.SlPercent = slPct.Value;

                var tgtPct = await SettingsService.GetSettingAsync<decimal?>($"Target.Percent.{profile.Index}");
                if (tgtPct.HasValue) profile.TargetPercent = tgtPct.Value;
            }

            _adminUsername = await Auth.GetAdminUsernameAsync();
            _adminPassword = "";
            _confirmAdminPassword = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await SettingsService.SetSettingAsync("TradingMode",    _tradingMode);
            await SettingsService.SetSettingAsync("DefaultQuantity", _defaultQuantity);

            await SettingsService.SetSettingAsync("Mcx.Enabled", _mcxEnabled);
            McxToggle.Invalidate();

            foreach (var lot in _lotConfigs)
                await SettingsService.SetSettingAsync($"Lots.{lot.Underlying}", lot.Lots);

            await SettingsService.SetSettingAsync("DailyMaxLoss",       _dailyMaxLoss);
            await SettingsService.SetSettingAsync("DailyMaxProfit",     _dailyMaxProfit);
            await SettingsService.SetSettingAsync("RiskAutoSquareOffEnabled", _riskAutoSquareOffEnabled);
            await SettingsService.SetSettingAsync("MaxOpenPositions",   _maxOpenPositions);
            await SettingsService.SetSettingAsync("MaxTradesPerDay",    _maxTradesPerDay);
            await SettingsService.SetSettingAsync("StopLossBuffer",     _stopLossBuffer);
            await SettingsService.SetSettingAsync("BrowserNotifications", _browserNotifications);
            await SettingsService.SetSettingAsync("SoundAlerts",        _soundAlerts);
            await SettingsService.SetSettingAsync("KillSwitch",         _killSwitch);
            await SettingsService.SetSettingAsync("AllowAfterMarketHours", _allowAfterMarketHours);
            await SettingsService.SetSettingAsync("AutoSquareOffEnabled", _autoSquareOffEnabled);
            await SettingsService.SetSettingAsync("AutoSquareOffTime", _autoSquareOffTime);

            await SettingsService.SetSettingAsync("SignalTimeWindowEnabled", _signalTimeWindowEnabled);
            await SettingsService.SetSettingAsync("SignalTimeWindowStart", _signalTimeWindowStart);
            await SettingsService.SetSettingAsync("SignalTimeWindowEnd", _signalTimeWindowEnd);
            await SettingsService.SetSettingAsync("SlippageGuardEnabled", _slippageGuardEnabled);
            await SettingsService.SetSettingAsync("MaxSlippagePercent", _maxSlippagePercent);

            await SettingsService.SetSettingAsync("EnableEntryPriceCrossingTrigger", _enableEntryCrossingTrigger);
            await SettingsService.SetSettingAsync("RequireEntryCrossFromBelow", _requireEntryCrossFromBelow);
            await SettingsService.SetSettingAsync("EntryPriceOffset", _entryPriceOffset);
            await SettingsService.SetSettingAsync("TargetPriceOffset", _targetPriceOffset);
            await SettingsService.SetSettingAsync("DefaultTargetPoints", _defaultTargetPoints);
            await SettingsService.SetSettingAsync("DefaultStopLossPoints", _defaultStopLossPoints);
            await SettingsService.SetSettingAsync("ExitPriceOffset", _exitPriceOffset);
            await SettingsService.SetSettingAsync("PendingOrderTimeoutMinutes", _pendingOrderTimeoutMinutes);
            await SettingsService.SetSettingAsync("DuplicateSignalCooldownMinutes", _duplicateSignalCooldownMinutes);
            await SettingsService.SetSettingAsync("PnlHistoryRetentionDays", _pnlHistoryRetentionDays);
            await SettingsService.SetSettingAsync("OrderVariety", _orderVariety);
            await SettingsService.SetSettingAsync("TrailingStopLossPoints", _trailingStopLossPoints);

            await SettingsService.SetSettingAsync("Risk.SlMode", _riskSlMode);
            foreach (var profile in _indexProfiles)
            {
                await SettingsService.SetSettingAsync($"SL.Points.{profile.Index}", profile.DefaultSlPoints);
                await SettingsService.SetSettingAsync($"Target.Points.{profile.Index}", profile.DefaultTargetPoints);
                await SettingsService.SetSettingAsync($"Target.Override.{profile.Index}", profile.OverrideTargetPoints);
                await SettingsService.SetSettingAsync($"SL.Percent.{profile.Index}", profile.SlPercent);
                await SettingsService.SetSettingAsync($"Target.Percent.{profile.Index}", profile.TargetPercent);
            }

            if (!string.IsNullOrWhiteSpace(_adminUsername))
            {
                var currentUsername = await Auth.GetAdminUsernameAsync();
                if (!string.Equals(_adminUsername.Trim(), currentUsername, StringComparison.OrdinalIgnoreCase))
                {
                    await Auth.UpdateUsernameAsync(_adminUsername.Trim());
                }
            }

            if (!string.IsNullOrWhiteSpace(_adminPassword))
            {
                if (!string.IsNullOrWhiteSpace(_confirmAdminPassword) && !string.Equals(_adminPassword, _confirmAdminPassword))
                {
                    Snackbar.Add("Warning: New password and confirm password did not match, password was not updated.", Severity.Warning);
                }
                else
                {
                    await Auth.UpdatePasswordAsync(_adminPassword);
                    _adminPassword = "";
                    _confirmAdminPassword = "";
                    Snackbar.Add("Admin password updated successfully!", Severity.Success);
                }
            }

            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }
}
