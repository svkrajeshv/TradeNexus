@page "/signals"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Globalization
@using System.Text
@inject IJSRuntime JS
@using NexusApp.Data
@using NexusApp.Models
@using NexusApp.Services
@inject TradingSignalService SignalService
@inject IDbContextFactory<TradingDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>NexusApp - Signals</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Signals</MudText>

<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2" AlignItems="AlignItems.Center">
    <MudDatePicker @bind-Date="_selectedDate" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 180px;" />
    <MudButton OnClick="LoadAsync" Color="Color.Primary" Variant="Variant.Filled">Load</MudButton>
    <MudSpacer />
    <MudText Typo="Typo.body2">Total: @_signals.Count</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Download"
               OnClick="DownloadSignalsAsync"
               Color="Color.Primary"
               Variant="Variant.Outlined"
               Disabled="_downloading || _signals.Count == 0">
        @(_downloading ? "Preparing..." : $"Download ({_signals.Count})")
    </MudButton>
</MudStack>

<MudPaper Class="pa-2 pa-sm-4" Elevation="2">
    <MudTable Items="SortedSignals" HorizontalScrollbar="true" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnTime)">Time @SortIndicator(_sortColumnTime)</MudButton></MudTh>
            <MudTh Style="width:130px; max-width:145px;"><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnChannel)">Channel @SortIndicator(_sortColumnChannel)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnAction)">Action @SortIndicator(_sortColumnAction)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnSymbol)">Symbol @SortIndicator(_sortColumnSymbol)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnEntry)">Entry @SortIndicator(_sortColumnEntry)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnSl)">SL @SortIndicator(_sortColumnSl)</MudButton></MudTh>
            <MudTh>Targets</MudTh>
            <MudTh Style="min-width:130px;"><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnStatus)">Status @SortIndicator(_sortColumnStatus)</MudButton></MudTh>
            <MudTh Style="min-width:350px; width:45%;">Message</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="white-space:nowrap;">@context.ReceivedTimestamp.ToIstString("hh:mm:ss tt")</MudTd>
            <MudTd Style="width:130px; max-width:145px; overflow:hidden;">
                @if (!string.IsNullOrWhiteSpace(context.ChannelName))
                {
                    <MudChip T="string" Class="channel-chip" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" title="@context.ChannelName">@context.ChannelName</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.Action == SignalAction.Buy ? Color.Success : Color.Error)">@context.Action</MudChip>
            </MudTd>
            <MudTd Style="white-space:nowrap;">
                @if (!string.IsNullOrWhiteSpace(context.Symbol))
                {
                    <MudTooltip Text="@($"Parsed from signal: {context.Index} {FormatStrike(context.Strike)} {context.OptionType.ToString().ToUpper()}")">
                        <span>@context.Symbol</span>
                    </MudTooltip>
                }
                else
                {
                    @($"{context.Index} {FormatStrike(context.Strike)} {context.OptionType.ToString().ToUpper()}")
                }
            </MudTd>
            <MudTd>@context.EntryPrice</MudTd>
            <MudTd>@context.StopLoss</MudTd>
            <MudTd Style="white-space:nowrap;">@string.Join(" / ", context.Targets)</MudTd>
            <MudTd Style="min-width:130px; white-space:nowrap;">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
                @if (context.Status == SignalStatus.Failed)
                {
                    var errorMsg = context.Orders?.FirstOrDefault(o => !string.IsNullOrEmpty(o.ErrorMessage))?.ErrorMessage;
                    if (!string.IsNullOrWhiteSpace(errorMsg))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1" Style="max-width:100px;white-space:normal;line-height:1.2;font-weight:500">
                            @errorMsg
                        </MudText>
                    }
                }
            </MudTd>
            <MudTd Style="min-width:350px; width:45%; max-width:650px; white-space:pre-wrap; word-break:break-word; font-size:0.75rem; color:var(--mud-palette-text-secondary);">@context.OriginalMessage</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private DateTime? _selectedDate = DateTime.UtcNow.ToIst().Date;
    private List<TradingSignal> _signals = new();
    private bool _downloading;

    /// <summary>
    /// Exports the currently loaded signals (in the grid's sort order) as a CSV.
    /// </summary>
    private async Task DownloadSignalsAsync()
    {
        if (_downloading) return;
        _downloading = true;

        try
        {
            var signals = SortedSignals.ToList();
            if (signals.Count == 0)
            {
                Snackbar.Add("Nothing to download.", Severity.Info);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine(string.Join(",",
                "Signal Id", "Received (IST)", "Telegram Time (IST)", "Processed (IST)", "Signal Delay (ms)",
                "Channel", "Action", "Index", "Strike", "Option Type", "Symbol", "Expiry Date",
                "Entry Price", "Stop Loss", "Targets", "Status", "Error", "Message"));

            foreach (var s in signals)
            {
                var error = s.Orders?.FirstOrDefault(o => !string.IsNullOrEmpty(o.ErrorMessage))?.ErrorMessage;
                sb.AppendLine(string.Join(",",
                    Csv(s.Id),
                    Csv(s.ReceivedTimestamp.ToIstString()),
                    Csv(s.TelegramTimestamp.ToIstString()),
                    Csv(s.ProcessedTimestamp.ToIstString()),
                    Csv(s.SignalDelayMs),
                    Csv(s.ChannelName),
                    Csv(s.Action),
                    Csv(s.Index),
                    Csv(s.Strike),
                    Csv(s.OptionType),
                    Csv(s.Symbol),
                    Csv(s.ExpiryDate.ToIstString("yyyy-MM-dd")),
                    Csv(s.EntryPrice),
                    Csv(s.StopLoss),
                    Csv(string.Join(" | ", s.Targets)),
                    Csv(s.Status),
                    Csv(error),
                    Csv(s.OriginalMessage)));
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var fileName = $"signals-{(_selectedDate ?? DateTime.UtcNow.ToIst().Date):yyyyMMdd}-{DateTime.UtcNow.ToIst():HHmmss}.csv";

            await JS.InvokeVoidAsync("NexusApp.downloadFile", fileName, "text/csv", Convert.ToBase64String(bytes));
            Snackbar.Add($"Downloaded {signals.Count} signals.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloading = false;
        }
    }

    private static string Csv(object? value)
    {
        if (value is null) return string.Empty;

        var text = value is IFormattable formattable
            ? formattable.ToString(null, CultureInfo.InvariantCulture)
            : value.ToString() ?? string.Empty;

        if (text.IndexOfAny([',', '"', '\n', '\r']) < 0)
            return text;

        return $"\"{text.Replace("\"", "\"\"")}\"";
    }

    private const string _sortColumnTime = "time";
    private const string _sortColumnChannel = "channel";
    private const string _sortColumnAction = "action";
    private const string _sortColumnSymbol = "symbol";
    private const string _sortColumnEntry = "entry";
    private const string _sortColumnSl = "sl";
    private const string _sortColumnStatus = "status";

    private string _sortColumn = _sortColumnTime;
    private bool _sortDescending = true;

    private IEnumerable<TradingSignal> SortedSignals =>
        (_sortColumn, _sortDescending) switch
        {
            (_sortColumnChannel, true) => _signals.OrderByDescending(s => s.ChannelName ?? string.Empty),
            (_sortColumnChannel, false) => _signals.OrderBy(s => s.ChannelName ?? string.Empty),

            (_sortColumnAction, true) => _signals.OrderByDescending(s => s.Action),
            (_sortColumnAction, false) => _signals.OrderBy(s => s.Action),

            (_sortColumnSymbol, true) => _signals.OrderByDescending(s => s.Index)
                                                 .ThenByDescending(s => s.Strike)
                                                 .ThenByDescending(s => s.OptionType),
            (_sortColumnSymbol, false) => _signals.OrderBy(s => s.Index)
                                                  .ThenBy(s => s.Strike)
                                                  .ThenBy(s => s.OptionType),

            (_sortColumnEntry, true) => _signals.OrderByDescending(s => s.EntryPrice),
            (_sortColumnEntry, false) => _signals.OrderBy(s => s.EntryPrice),

            (_sortColumnSl, true) => _signals.OrderByDescending(s => s.StopLoss),
            (_sortColumnSl, false) => _signals.OrderBy(s => s.StopLoss),

            (_sortColumnStatus, true) => _signals.OrderByDescending(s => s.Status),
            (_sortColumnStatus, false) => _signals.OrderBy(s => s.Status),

            (_, true) => _signals.OrderByDescending(s => s.ReceivedTimestamp),
            _ => _signals.OrderBy(s => s.ReceivedTimestamp)
        };

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = column == _sortColumnTime;
    }

    private string SortIndicator(string column) =>
        _sortColumn == column ? (_sortDescending ? "↓" : "↑") : string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            if (_selectedDate is null)
            {
                _signals = await SignalService.GetRecentSignalsAsync(100, includeOrders: true);
            }
            else
            {
                _signals = await SignalService.GetSignalsByDateAsync(_selectedDate.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);
        }
    }

    private Color StatusColor(SignalStatus s) => s switch
    {
        SignalStatus.Executed => Color.Success,
        SignalStatus.Failed => Color.Error,
        SignalStatus.Ignored => Color.Default,
        SignalStatus.Pending => Color.Warning,
        _ => Color.Info
    };

    private static string FormatStrike(decimal strike) =>
        strike.ToString("0.##", CultureInfo.InvariantCulture);
}