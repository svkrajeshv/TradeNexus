@page "/pnl"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NexusApp.Data
@using NexusApp.Models
@using NexusApp.Helpers
@using System.Globalization
@using System.Text
@inject IDbContextFactory<TradingDbContext> DbFactory
@inject NexusApp.Services.TradeHistoryService TradeHistory
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>NexusApp - PNL Statements</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">PNL Statements</MudText>
    <MudButtonGroup Color="Color.Success" Variant="Variant.Filled">
        <MudButton StartIcon="@Icons.Material.Filled.Download"
                   OnClick="() => DownloadAsync(false)"
                   Disabled="_downloading || _rows.Count == 0">
            @(_downloading ? "Preparing..." : $"Download Statement ({FilteredRows.Count})")
        </MudButton>
        <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Disabled="_downloading || _rows.Count == 0">
            <MudMenuItem OnClick="() => DownloadAsync(false)">Full Statement (Summary + Trades)</MudMenuItem>
            <MudMenuItem OnClick="() => DownloadAsync(true)">Trades Only (Clean CSV)</MudMenuItem>
        </MudMenu>
    </MudButtonGroup>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Spacing="2" Justify="Justify.FlexStart">
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="From" @bind-Date="_fromDate" Variant="Variant.Outlined" DateFormat="dd-MMM-yyyy" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="To" @bind-Date="_toDate" Variant="Variant.Outlined" DateFormat="dd-MMM-yyyy" />
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudSelect T="string" Label="Channel" @bind-Value="_selectedChannel" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem T="string" Value="@AllChannels">All Channels</MudSelectItem>
                @foreach (var ch in _channels)
                {
                    <MudSelectItem T="string" Value="@ch">@ch</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudSelect T="string" Label="Terminal" @bind-Value="_selectedTerminal" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem T="string" Value="@AllTerminals">All Terminals</MudSelectItem>
                @foreach (var t in _terminals)
                {
                    <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="ApplyAsync" Class="mr-2">Apply</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAsync">Reset</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Net P&amp;L (All)</MudText>
            <MudText Typo="Typo.h4" Color="@(_totalPnL >= 0 ? Color.Success : Color.Error)">@_totalPnL.ToString("N2")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Trades</MudText>
            <MudText Typo="Typo.h4">@_totalTrades</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Win Rate</MudText>
            <MudText Typo="Typo.h4" Color="@(_winRate >= 50 ? Color.Success : Color.Warning)">@_winRate.ToString("N1")%</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Wins / Losses</MudText>
            <MudText Typo="Typo.h4">
                <MudText Typo="Typo.h4" Color="Color.Success" Inline="true">@_wins</MudText>
                <MudText Typo="Typo.h4" Inline="true"> / </MudText>
                <MudText Typo="Typo.h4" Color="Color.Error" Inline="true">@_losses</MudText>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* Separate Live vs Paper summaries so a mixed book never blends the two P&Ls
   into one confusing "All" number. Each card pair is computed from its own
   filtered subset of _rows (see ComputeStats), never from the combined total. *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid var(--mud-palette-success);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">⚡ Live</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Real Account</MudChip>
            </MudStack>
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Net P&amp;L</MudText>
                    <MudText Typo="Typo.h6" Color="@(_liveStats.NetPnL >= 0 ? Color.Success : Color.Error)">@_liveStats.NetPnL.ToString("N2")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Trades</MudText>
                    <MudText Typo="Typo.h6">@_liveStats.Trades</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Win Rate</MudText>
                    <MudText Typo="Typo.h6" Color="@(_liveStats.WinRate >= 50 ? Color.Success : Color.Warning)">@_liveStats.WinRate.ToString("N1")%</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Wins / Losses</MudText>
                    <MudText Typo="Typo.h6">
                        <MudText Typo="Typo.h6" Color="Color.Success" Inline="true">@_liveStats.Wins</MudText>
                        <MudText Typo="Typo.h6" Inline="true"> / </MudText>
                        <MudText Typo="Typo.h6" Color="Color.Error" Inline="true">@_liveStats.Losses</MudText>
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid var(--mud-palette-tertiary);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">📝 Paper</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">Simulated Account</MudChip>
            </MudStack>
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Net P&amp;L</MudText>
                    <MudText Typo="Typo.h6" Color="@(_paperStats.NetPnL >= 0 ? Color.Success : Color.Error)">@_paperStats.NetPnL.ToString("N2")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Trades</MudText>
                    <MudText Typo="Typo.h6">@_paperStats.Trades</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Win Rate</MudText>
                    <MudText Typo="Typo.h6" Color="@(_paperStats.WinRate >= 50 ? Color.Success : Color.Warning)">@_paperStats.WinRate.ToString("N1")%</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Wins / Losses</MudText>
                    <MudText Typo="Typo.h6">
                        <MudText Typo="Typo.h6" Color="Color.Success" Inline="true">@_paperStats.Wins</MudText>
                        <MudText Typo="Typo.h6" Inline="true"> / </MudText>
                        <MudText Typo="Typo.h6" Color="Color.Error" Inline="true">@_paperStats.Losses</MudText>
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Performance by Channel</MudText>
        <MudToggleGroup T="string" @bind-Value="_channelBookFilter" Color="Color.Primary" Size="Size.Small">
            <MudToggleItem Value="@AllBooks">All</MudToggleItem>
            <MudToggleItem Value="@LiveBook">Live</MudToggleItem>
            <MudToggleItem Value="@PaperBook">Paper</MudToggleItem>
        </MudToggleGroup>
    </MudStack>
    @if (FilteredChannelStats.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No closed trades in the selected range.</MudText>
    }
    else
    {
        <MudTable Items="FilteredChannelStats" Dense="true" Hover="true" Striped="true" HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh>Channel</MudTh>
                <MudTh>Book</MudTh>
                <MudTh>Trades</MudTh>
                <MudTh>Wins</MudTh>
                <MudTh>Losses</MudTh>
                <MudTh>Win %</MudTh>
                <MudTh>Net P&amp;L</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Channel">@context.Channel</MudTd>
                <MudTd DataLabel="Book">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsPaper ? Color.Tertiary : Color.Success)">
                        @(context.IsPaper ? "PAPER" : "LIVE")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Trades">@context.Trades</MudTd>
                <MudTd DataLabel="Wins">@context.Wins</MudTd>
                <MudTd DataLabel="Losses">@context.Losses</MudTd>
                <MudTd DataLabel="Win %">@context.WinRate.ToString("N1")%</MudTd>
                <MudTd DataLabel="Net P&amp;L">
                    <MudText Color="@(context.NetPnL >= 0 ? Color.Success : Color.Error)">@context.NetPnL.ToString("N2")</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Performance by Terminal</MudText>
        <MudToggleGroup T="string" @bind-Value="_terminalBookFilter" Color="Color.Primary" Size="Size.Small">
            <MudToggleItem Value="@AllBooks">All</MudToggleItem>
            <MudToggleItem Value="@LiveBook">Live</MudToggleItem>
            <MudToggleItem Value="@PaperBook">Paper</MudToggleItem>
        </MudToggleGroup>
    </MudStack>
    @if (FilteredTerminalStats.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No closed trades in the selected range.</MudText>
    }
    else
    {
        <MudTable Items="FilteredTerminalStats" Dense="true" Hover="true" Striped="true" HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh>Terminal</MudTh>
                <MudTh>Book</MudTh>
                <MudTh>Trades</MudTh>
                <MudTh>Wins</MudTh>
                <MudTh>Losses</MudTh>
                <MudTh>Win %</MudTh>
                <MudTh>Net P&amp;L</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Terminal">@context.Terminal</MudTd>
                <MudTd DataLabel="Book">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsPaper ? Color.Tertiary : Color.Success)">
                        @(context.IsPaper ? "PAPER" : "LIVE")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Trades">@context.Trades</MudTd>
                <MudTd DataLabel="Wins">@context.Wins</MudTd>
                <MudTd DataLabel="Losses">@context.Losses</MudTd>
                <MudTd DataLabel="Win %">@context.WinRate.ToString("N1")%</MudTd>
                <MudTd DataLabel="Net P&amp;L">
                    <MudText Color="@(context.NetPnL >= 0 ? Color.Success : Color.Error)">@context.NetPnL.ToString("N2")</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Executed Trades</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudToggleGroup T="string" @bind-Value="_rowsBookFilter" Color="Color.Primary" Size="Size.Small">
                <MudToggleItem Value="@AllBooks">All</MudToggleItem>
                <MudToggleItem Value="@LiveBook">Live</MudToggleItem>
                <MudToggleItem Value="@PaperBook">Paper</MudToggleItem>
            </MudToggleGroup>
            <MudTooltip Text="Download executed trades as CSV">
                <MudIconButton Icon="@Icons.Material.Filled.Download"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="() => DownloadAsync(true)"
                               Disabled="_downloading || FilteredRows.Count == 0" />
            </MudTooltip>
        </MudStack>
    </MudStack>
    @if (FilteredRows.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No executed trades in the selected range.</MudText>
    }
    else
    {
        <MudTable Items="FilteredRows" Dense="true" Hover="true" Striped="true" HorizontalScrollbar="true"
                  Filter="null" Bordered="false" FixedHeader="true" Height="480px">
            <HeaderContent>
                <MudTh>Closed</MudTh>
                <MudTh>Book</MudTh>
                <MudTh>Channel</MudTh>
                <MudTh>Terminal</MudTh>
                <MudTh>Symbol</MudTh>
                <MudTh>Qty</MudTh>
                <MudTh>Entry</MudTh>
                <MudTh>Exit</MudTh>
                <MudTh>Realised P&amp;L</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Closed">@context.ClosedAt.ToIstString("dd-MMM hh:mm:ss tt")</MudTd>
                <MudTd DataLabel="Book">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsPaper ? Color.Tertiary : Color.Success)">
                        @(context.IsPaper ? "PAPER" : "LIVE")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Channel">@context.Channel</MudTd>
                <MudTd DataLabel="Terminal">@context.Terminal</MudTd>
                <MudTd DataLabel="Symbol">@context.Symbol</MudTd>
                <MudTd DataLabel="Qty">@context.Quantity</MudTd>
                <MudTd DataLabel="Entry">@context.EntryPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="Exit">@(context.ExitPrice?.ToString("N2") ?? "-")</MudTd>
                <MudTd DataLabel="Realised P&amp;L">
                    <MudText Color="@(context.RealizedPnL >= 0 ? Color.Success : Color.Error)">@context.RealizedPnL.ToString("N2")</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private const string AllChannels = "__ALL__";
    private const string AllTerminals = "__ALL__";
    private const string UnknownChannel = "Unknown";
    private const string UnknownTerminal = "Unknown";

    private const string AllBooks = "all";
    private const string LiveBook = "live";
    private const string PaperBook = "paper";

    private static DateTime IstToday() => DateTime.UtcNow.ToIst().Date;
    private static DateTime DefaultFromDate() => IstToday().AddDays(-30);

    private DateTime? _fromDate = DefaultFromDate();
    private DateTime? _toDate = IstToday();
    private string _selectedChannel = AllChannels;
    private string _selectedTerminal = AllTerminals;

    // Independent Book filters per section so, e.g., viewing the Live channel
    // breakdown does not force the trade list into the same filter.
    private string _channelBookFilter = AllBooks;
    private string _terminalBookFilter = AllBooks;
    private string _rowsBookFilter = AllBooks;

    private readonly List<string> _channels = new();
    private readonly List<string> _terminals = new();
    private List<TradeRow> _rows = new();
    private List<ChannelStat> _channelStats = new();
    private List<TerminalStat> _terminalStats = new();

    private decimal _totalPnL;
    private int _totalTrades;
    private int _wins;
    private int _losses;
    private double _winRate;

    private BookSummary _liveStats;
    private BookSummary _paperStats;

    private List<ChannelStat> FilteredChannelStats => _channelBookFilter switch
    {
        LiveBook => _channelStats.Where(c => !c.IsPaper).ToList(),
        PaperBook => _channelStats.Where(c => c.IsPaper).ToList(),
        _ => _channelStats
    };

    private List<TerminalStat> FilteredTerminalStats => _terminalBookFilter switch
    {
        LiveBook => _terminalStats.Where(t => !t.IsPaper).ToList(),
        PaperBook => _terminalStats.Where(t => t.IsPaper).ToList(),
        _ => _terminalStats
    };

    private List<TradeRow> FilteredRows => _rowsBookFilter switch
    {
        LiveBook => _rows.Where(r => !r.IsPaper).ToList(),
        PaperBook => _rows.Where(r => r.IsPaper).ToList(),
        _ => _rows
    };

    protected override async Task OnInitializedAsync()
    {
        // Capture any not-yet-archived closed positions so today's trades appear immediately.
        try { await TradeHistory.ArchiveClosedPositionsAsync(); }
        catch { /* archive is best-effort; page still renders from existing history */ }

        await LoadFiltersAsync();
        await ApplyAsync();
    }

    private async Task LoadFiltersAsync()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var names = await db.ClosedTradeHistory.AsNoTracking()
                .Where(h => h.ChannelName != null && h.ChannelName != string.Empty)
                .Select(h => h.ChannelName)
                .Distinct()
                .OrderBy(n => n)
                .ToListAsync();

            _channels.Clear();
            _channels.AddRange(names);

            var terminals = await db.ClosedTradeHistory.AsNoTracking()
                .Where(h => h.TerminalName != null && h.TerminalName != string.Empty)
                .Select(h => h.TerminalName)
                .Distinct()
                .OrderBy(n => n)
                .ToListAsync();

            _terminals.Clear();
            _terminals.AddRange(terminals);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load filters: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApplyAsync()
    {
        try
        {
            // Pickers hold IST calendar dates; ClosedAt is stored in UTC.
            var fromUtc = (_fromDate ?? DefaultFromDate()).Date.IstToUtc();
            var toUtc = (_toDate ?? IstToday()).Date.AddDays(1).IstToUtc(); // inclusive end-of-day

            using var db = await DbFactory.CreateDbContextAsync();

            // Durable P&L history survives the daily/session cleanup that deletes positions.
            var query =
                from h in db.ClosedTradeHistory.AsNoTracking()
                where h.ClosedAt >= fromUtc && h.ClosedAt < toUtc
                select new TradeRow
                {
                    OpenedAt = h.OpenedAt,
                    ClosedAt = h.ClosedAt,
                    Channel = h.ChannelName != null && h.ChannelName != string.Empty ? h.ChannelName : UnknownChannel,
                    Terminal = h.TerminalName != null && h.TerminalName != string.Empty ? h.TerminalName : UnknownTerminal,
                    Symbol = h.Symbol,
                    Quantity = h.Quantity,
                    EntryPrice = h.EntryPrice,
                    ExitPrice = h.ExitPrice,
                    RealizedPnL = h.RealizedPnL,
                    IsPaper = h.IsPaper
                };

            var rows = await query.OrderByDescending(r => r.ClosedAt).ToListAsync();

            if (_selectedChannel != AllChannels && !string.IsNullOrEmpty(_selectedChannel))
                rows = rows.Where(r => string.Equals(r.Channel, _selectedChannel, StringComparison.OrdinalIgnoreCase)).ToList();

            if (_selectedTerminal != AllTerminals && !string.IsNullOrEmpty(_selectedTerminal))
                rows = rows.Where(r => string.Equals(r.Terminal, _selectedTerminal, StringComparison.OrdinalIgnoreCase)).ToList();

            _rows = rows;
            ComputeStats();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load PNL statements: {ex.Message}", Severity.Error);
        }
    }

    private async Task ResetAsync()
    {
        _fromDate = DefaultFromDate();
        _toDate = IstToday();
        _selectedChannel = AllChannels;
        _selectedTerminal = AllTerminals;
        await ApplyAsync();
    }

    private static BookSummary Summarize(IReadOnlyCollection<TradeRow> rows)
    {
        var trades = rows.Count;
        var wins = rows.Count(r => r.RealizedPnL > 0);
        var losses = rows.Count(r => r.RealizedPnL < 0);
        return new BookSummary
        {
            Trades = trades,
            Wins = wins,
            Losses = losses,
            NetPnL = rows.Sum(r => r.RealizedPnL),
            WinRate = trades > 0 ? (double)wins / trades * 100.0 : 0
        };
    }

    private void ComputeStats()
    {
        _totalTrades = _rows.Count;
        _totalPnL = _rows.Sum(r => r.RealizedPnL);
        _wins = _rows.Count(r => r.RealizedPnL > 0);
        _losses = _rows.Count(r => r.RealizedPnL < 0);
        _winRate = _totalTrades > 0 ? (double)_wins / _totalTrades * 100.0 : 0;

        // Live and Paper are summarised independently — never derived from or
        // blended into the "All" total above, so a losing paper session can
        // never be masked by (or confused with) live profits and vice versa.
        _liveStats = Summarize(_rows.Where(r => !r.IsPaper).ToList());
        _paperStats = Summarize(_rows.Where(r => r.IsPaper).ToList());

        _channelStats = _rows
            .GroupBy(r => (r.Channel, r.IsPaper))
            .Select(g => new ChannelStat
            {
                Channel = g.Key.Channel,
                IsPaper = g.Key.IsPaper,
                Trades = g.Count(),
                Wins = g.Count(r => r.RealizedPnL > 0),
                Losses = g.Count(r => r.RealizedPnL < 0),
                NetPnL = g.Sum(r => r.RealizedPnL),
                WinRate = g.Count() > 0 ? (double)g.Count(r => r.RealizedPnL > 0) / g.Count() * 100.0 : 0
            })
            .OrderBy(c => c.IsPaper)
            .ThenByDescending(c => c.NetPnL)
            .ToList();

        _terminalStats = _rows
            .GroupBy(r => (r.Terminal, r.IsPaper))
            .Select(g => new TerminalStat
            {
                Terminal = g.Key.Terminal,
                IsPaper = g.Key.IsPaper,
                Trades = g.Count(),
                Wins = g.Count(r => r.RealizedPnL > 0),
                Losses = g.Count(r => r.RealizedPnL < 0),
                NetPnL = g.Sum(r => r.RealizedPnL),
                WinRate = g.Count() > 0 ? (double)g.Count(r => r.RealizedPnL > 0) / g.Count() * 100.0 : 0
            })
            .OrderBy(t => t.IsPaper)
            .ThenByDescending(t => t.NetPnL)
            .ToList();
    }

    private sealed class TradeRow
    {
        public DateTime OpenedAt { get; set; }
        public DateTime ClosedAt { get; set; }
        public string Channel { get; set; } = string.Empty;
        public string Terminal { get; set; } = string.Empty;
        public string Symbol { get; set; } = string.Empty;
