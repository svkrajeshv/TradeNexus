    private bool _downloading;

    private async Task DownloadAsync(bool tradesOnly = false)
    {
        if (_downloading) return;
        _downloading = true;

        try
        {
            var rows = FilteredRows;
            if (rows.Count == 0)
            {
                Snackbar.Add("No trades to download in the selected range.", Severity.Info);
                return;
            }

            var csv = tradesOnly
                ? BuildTradesOnlyCsv(rows)
                : BuildFullStatementCsv(rows);

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv)).ToArray();
            var fromStr = (_fromDate ?? DefaultFromDate()).ToString("yyyyMMdd");
            var toStr = (_toDate ?? IstToday()).ToString("yyyyMMdd");
            var fileName = tradesOnly
                ? $"pnl-trades-{fromStr}-to-{toStr}.csv"
                : $"pnl-statement-{fromStr}-to-{toStr}.csv";

            await JS.InvokeVoidAsync("NexusApp.downloadFile", fileName, "text/csv", Convert.ToBase64String(bytes));
            Snackbar.Add($"Downloaded {rows.Count} trades to {fileName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloading = false;
        }
    }

    private string BuildTradesOnlyCsv(List<TradeRow> rows)
    {
        var sb = new StringBuilder();
        sb.AppendLine(string.Join(",",
            "Trade #",
            "Opened (IST)",
            "Closed (IST)",
            "Book",
            "Channel",
            "Terminal",
            "Symbol",
            "Quantity",
            "Entry Price",
            "Exit Price",
            "Points Captured",
            "Realized PnL (INR)",
            "Return (%)",
            "Outcome"));

        for (var i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var points = r.Quantity > 0 ? r.RealizedPnL / r.Quantity : 0m;
            var returnPct = (r.EntryPrice > 0 && r.Quantity > 0)
                ? (r.RealizedPnL / (r.EntryPrice * r.Quantity)) * 100m
                : 0m;
            var outcome = r.RealizedPnL > 0 ? "WIN" : (r.RealizedPnL < 0 ? "LOSS" : "BREAKEVEN");

            sb.AppendLine(string.Join(",",
                Csv(i + 1),
                Csv(r.OpenedAt.ToIstString()),
                Csv(r.ClosedAt.ToIstString()),
                Csv(r.IsPaper ? "PAPER" : "LIVE"),
                Csv(r.Channel),
                Csv(r.Terminal),
                Csv(r.Symbol),
                Csv(r.Quantity),
                Csv(r.EntryPrice),
                Csv(r.ExitPrice),
                Csv(points),
                Csv(r.RealizedPnL),
                Csv(returnPct.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
                Csv(outcome)));
        }

        return sb.ToString();
    }

    private string BuildFullStatementCsv(List<TradeRow> rows)
    {
        var sb = new StringBuilder();
        var fromText = (_fromDate ?? DefaultFromDate()).ToString("dd-MMM-yyyy");
        var toText = (_toDate ?? IstToday()).ToString("dd-MMM-yyyy");

        sb.AppendLine("# ==============================================================================");
        sb.AppendLine("# NEXUSAPP — P&L STATEMENT");
        sb.AppendLine("# ==============================================================================");
        sb.AppendLine($"# Statement Period: {fromText} to {toText} (IST)");
        sb.AppendLine($"# Generated At: {DateTime.UtcNow.ToIstString()} IST");
        sb.AppendLine($"# Channel Filter: {(_selectedChannel == AllChannels ? "All Channels" : _selectedChannel)}");
        sb.AppendLine($"# Terminal Filter: {(_selectedTerminal == AllTerminals ? "All Terminals" : _selectedTerminal)}");
        sb.AppendLine($"# Book Filter: {_rowsBookFilter.ToUpperInvariant()}");
        sb.AppendLine("# ==============================================================================");
        sb.AppendLine();

        sb.AppendLine("# EXECUTIVE SUMMARY");
        sb.AppendLine(string.Join(",", "Book", "Trades", "Wins", "Losses", "Win Rate (%)", "Net Realized PnL (INR)"));
        sb.AppendLine(string.Join(",",
            "Overall (All)",
            Csv(_totalTrades),
            Csv(_wins),
            Csv(_losses),
            Csv(_winRate.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
            Csv(_totalPnL)));
        sb.AppendLine(string.Join(",",
            "Live Book",
            Csv(_liveStats.Trades),
            Csv(_liveStats.Wins),
            Csv(_liveStats.Losses),
            Csv(_liveStats.WinRate.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
            Csv(_liveStats.NetPnL)));
        sb.AppendLine(string.Join(",",
            "Paper Book",
            Csv(_paperStats.Trades),
            Csv(_paperStats.Wins),
            Csv(_paperStats.Losses),
            Csv(_paperStats.WinRate.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
            Csv(_paperStats.NetPnL)));
        sb.AppendLine();

        sb.AppendLine("# PERFORMANCE BY CHANNEL");
        sb.AppendLine(string.Join(",", "Channel", "Book", "Trades", "Wins", "Losses", "Win Rate (%)", "Net Realized PnL (INR)"));
        foreach (var cs in FilteredChannelStats)
        {
            sb.AppendLine(string.Join(",",
                Csv(cs.Channel),
                Csv(cs.IsPaper ? "PAPER" : "LIVE"),
                Csv(cs.Trades),
                Csv(cs.Wins),
                Csv(cs.Losses),
                Csv(cs.WinRate.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
                Csv(cs.NetPnL)));
        }
        sb.AppendLine();

        sb.AppendLine("# PERFORMANCE BY TERMINAL");
        sb.AppendLine(string.Join(",", "Terminal", "Book", "Trades", "Wins", "Losses", "Win Rate (%)", "Net Realized PnL (INR)"));
        foreach (var ts in FilteredTerminalStats)
        {
            sb.AppendLine(string.Join(",",
                Csv(ts.Terminal),
                Csv(ts.IsPaper ? "PAPER" : "LIVE"),
                Csv(ts.Trades),
                Csv(ts.Wins),
                Csv(ts.Losses),
                Csv(ts.WinRate.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
                Csv(ts.NetPnL)));
        }
        sb.AppendLine();

        sb.AppendLine("# EXECUTED TRADES");
        sb.AppendLine(string.Join(",",
            "Trade #",
            "Opened (IST)",
            "Closed (IST)",
            "Book",
            "Channel",
            "Terminal",
            "Symbol",
            "Quantity",
            "Entry Price",
            "Exit Price",
            "Points Captured",
            "Realized PnL (INR)",
            "Return (%)",
            "Outcome"));

        for (var i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var points = r.Quantity > 0 ? r.RealizedPnL / r.Quantity : 0m;
            var returnPct = (r.EntryPrice > 0 && r.Quantity > 0)
                ? (r.RealizedPnL / (r.EntryPrice * r.Quantity)) * 100m
                : 0m;
            var outcome = r.RealizedPnL > 0 ? "WIN" : (r.RealizedPnL < 0 ? "LOSS" : "BREAKEVEN");

            sb.AppendLine(string.Join(",",
                Csv(i + 1),
                Csv(r.OpenedAt.ToIstString()),
                Csv(r.ClosedAt.ToIstString()),
                Csv(r.IsPaper ? "PAPER" : "LIVE"),
                Csv(r.Channel),
                Csv(r.Terminal),
                Csv(r.Symbol),
                Csv(r.Quantity),
                Csv(r.EntryPrice),
                Csv(r.ExitPrice),
                Csv(points),
                Csv(r.RealizedPnL),
                Csv(returnPct.ToString("0.##", CultureInfo.InvariantCulture) + "%"),
                Csv(outcome)));
        }

        return sb.ToString();
    }

    private static string Csv(object? value)
    {
        if (value is null) return string.Empty;

        var text = value is IFormattable formattable
            ? formattable.ToString(null, CultureInfo.InvariantCulture)
            : value.ToString() ?? string.Empty;

        if (text.IndexOfAny([',', '"', '\n', '\r']) < 0)
            return text;

        return $"\"{text.Replace("\"", "\"\"")}\"";
    }
