@page "/orders"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NexusApp.Data
@using NexusApp.Helpers
@using NexusApp.Interfaces
@using NexusApp.Models
@using System.Globalization
@using System.Text
@inject IDbContextFactory<TradingDbContext> DbFactory
@inject IBroker Broker
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NexusApp.Services.HubConnectionFactory HubFactory
@implements IAsyncDisposable

<PageTitle>NexusApp - Orders</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Orders</MudText>

<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2" AlignItems="AlignItems.Center">
    <MudSelect T="string" Value="_tradeFilter" ValueChanged="OnTradeFilterChanged" Label="Trade Type" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 120px;">
        <MudSelectItem Value="@("paper")">Paper</MudSelectItem>
        <MudSelectItem Value="@("both")">Both</MudSelectItem>
        <MudSelectItem Value="@("real")">Real</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Value="_filter" ValueChanged="OnStatusFilterChanged" Label="Status" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 120px;">
        <MudSelectItem Value="@("all")">All</MudSelectItem>
        <MudSelectItem Value="@("pending")">Pending</MudSelectItem>
        <MudSelectItem Value="@("executed")">Executed</MudSelectItem>
        <MudSelectItem Value="@("rejected")">Rejected</MudSelectItem>
        <MudSelectItem Value="@("failed")">Failed</MudSelectItem>
        <MudSelectItem Value="@("cancelled")">Cancelled</MudSelectItem>
    </MudSelect>
    <MudButton OnClick="LoadAsync" Color="Color.Primary" Variant="Variant.Filled">Refresh</MudButton>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Download"
               OnClick="DownloadOrdersAsync"
               Color="Color.Primary"
               Variant="Variant.Outlined"
               Disabled="_downloading || _orders.Count == 0">
        @(_downloading ? "Preparing..." : $"Download ({_orders.Count})")
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.CancelPresentation"
               OnClick="CancelAllOpenAsync"
               Color="Color.Error"
               Variant="Variant.Outlined"
               Disabled="_cancelling || OpenOrderCount == 0">
        @(_cancelling ? "Cancelling..." : $"Cancel All Open ({OpenOrderCount})")
    </MudButton>
</MudStack>

<MudPaper Class="pa-2 pa-sm-4" Elevation="2">
    <MudTable Items="SortedOrders" HorizontalScrollbar="true" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh Style="white-space:nowrap;"><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnTime)">Time @SortIndicator(_sortColumnTime)</MudButton></MudTh>
            <MudTh Style="width:130px; max-width:145px;"><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnChannel)">Channel @SortIndicator(_sortColumnChannel)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnAccount)">Account @SortIndicator(_sortColumnAccount)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnBrokerId)">Broker Id @SortIndicator(_sortColumnBrokerId)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnSymbol)">Symbol @SortIndicator(_sortColumnSymbol)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnSide)">Side @SortIndicator(_sortColumnSide)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnQty)">Qty @SortIndicator(_sortColumnQty)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnPrice)">Price @SortIndicator(_sortColumnPrice)</MudButton></MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnFilled)">Filled @SortIndicator(_sortColumnFilled)</MudButton></MudTh>
            <MudTh Style="min-width:200px; max-width:260px;">Remarks</MudTh>
            <MudTh><MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0 text-none" OnClick="() => ToggleSort(_sortColumnStatus)">Status @SortIndicator(_sortColumnStatus)</MudButton></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="white-space:nowrap;">@context.CreatedAt.ToIstString("hh:mm:ss tt")</MudTd>
            <MudTd Style="width:130px; max-width:145px; overflow:hidden;">
                @if (!string.IsNullOrWhiteSpace(context.Signal?.ChannelName))
                {
                    <MudChip T="string" Class="channel-chip" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" title="@context.Signal.ChannelName">@context.Signal.ChannelName</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                }
            </MudTd>
            <MudTd Style="white-space:nowrap;">
                <MudText Typo="Typo.body2" Style="font-weight:500; white-space:nowrap;">@(context.TradingAccount?.Name ?? "Default")</MudText>
                @if (!string.IsNullOrWhiteSpace(context.TradingAccount?.BrokerType))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TradingAccount.BrokerType</MudText>
                }
            </MudTd>
            <MudTd>@(FormatBrokerId(context.BrokerId))</MudTd>
            <MudTd Style="white-space:nowrap;">@context.Symbol</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.Side == OrderSide.Buy ? Color.Success : Color.Error)">@context.Side</MudChip>
            </MudTd>
            <MudTd>@context.Quantity</MudTd>
            <MudTd>@context.Price</MudTd>
            <MudTd>@(context.ExecutedPrice?.ToString() ?? "-")</MudTd>
            <MudTd Style="min-width:200px; max-width:260px;">
                @if (string.IsNullOrWhiteSpace(context.ErrorMessage))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                }
                else
                {
                    <MudTooltip Text="@context.ErrorMessage">
                        <MudText Typo="Typo.body2"
                                 Class="remarks-cell"
                                 Color="@(IsFailureStatus(context.Status) ? Color.Error : Color.Default)">
                            @context.ErrorMessage
                        </MudText>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private string _tradeFilter = "both";
    private string _filter = "all";
    private List<Order> _orders = new();
    private bool _cancelling;
    private bool _downloading;
    private HubConnection? _hub;

    private const string _sortColumnTime = "time";
    private const string _sortColumnChannel = "channel";
    private const string _sortColumnAccount = "account";
    private const string _sortColumnBrokerId = "brokerid";
    private const string _sortColumnSymbol = "symbol";
    private const string _sortColumnSide = "side";
    private const string _sortColumnQty = "qty";
    private const string _sortColumnPrice = "price";
    private const string _sortColumnFilled = "filled";
    private const string _sortColumnStatus = "status";

    private string _sortColumn = _sortColumnTime;
    private bool _sortDescending = true;

    private IEnumerable<Order> SortedOrders =>
        (_sortColumn, _sortDescending) switch
        {
            (_sortColumnChannel, true) => _orders.OrderByDescending(o => o.Signal?.ChannelName ?? string.Empty),
            (_sortColumnChannel, false) => _orders.OrderBy(o => o.Signal?.ChannelName ?? string.Empty),

            (_sortColumnAccount, true) => _orders.OrderByDescending(o => o.TradingAccount?.Name ?? string.Empty),
            (_sortColumnAccount, false) => _orders.OrderBy(o => o.TradingAccount?.Name ?? string.Empty),

            (_sortColumnBrokerId, true) => _orders.OrderByDescending(o => o.BrokerId ?? string.Empty),
            (_sortColumnBrokerId, false) => _orders.OrderBy(o => o.BrokerId ?? string.Empty),

            (_sortColumnSymbol, true) => _orders.OrderByDescending(o => o.Symbol ?? string.Empty),
            (_sortColumnSymbol, false) => _orders.OrderBy(o => o.Symbol ?? string.Empty),

            (_sortColumnSide, true) => _orders.OrderByDescending(o => o.Side),
            (_sortColumnSide, false) => _orders.OrderBy(o => o.Side),

            (_sortColumnQty, true) => _orders.OrderByDescending(o => o.Quantity),
            (_sortColumnQty, false) => _orders.OrderBy(o => o.Quantity),

            (_sortColumnPrice, true) => _orders.OrderByDescending(o => o.Price),
            (_sortColumnPrice, false) => _orders.OrderBy(o => o.Price),

            (_sortColumnFilled, true) => _orders.OrderByDescending(o => o.ExecutedPrice ?? decimal.MinValue),
            (_sortColumnFilled, false) => _orders.OrderBy(o => o.ExecutedPrice ?? decimal.MinValue),

            (_sortColumnStatus, true) => _orders.OrderByDescending(o => o.Status),
            (_sortColumnStatus, false) => _orders.OrderBy(o => o.Status),

            (_, true) => _orders.OrderByDescending(o => o.CreatedAt),
            _ => _orders.OrderBy(o => o.CreatedAt)
        };

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = column == _sortColumnTime;
    }

    private string SortIndicator(string column) =>
        _sortColumn == column ? (_sortDescending ? "↓" : "↑") : string.Empty;

    private int OpenOrderCount => _orders.Count(IsCancellable);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try
        {
            _hub = HubFactory.Create(Nav);
            _hub.On("OrderStatusChanged", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            });
            await _hub.StartAsync();
        }
        catch { /* hub is best-effort; page still works without live push */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var q = db.Orders.AsNoTracking().Include(o => o.TradingAccount).Include(o => o.Signal).OrderByDescending(o => o.CreatedAt).AsQueryable();
            q = _tradeFilter switch
            {
                "paper" => q.Where(o => o.TradingAccount != null && o.TradingAccount.ClientId.ToUpper() == "PAPER"),
                "real" => q.Where(o => o.TradingAccount != null && o.TradingAccount.ClientId.ToUpper() != "PAPER"),
                _ => q
            };
            q = _filter switch
            {
                "pending" => q.Where(o => o.Status == OrderStatus.Pending || o.Status == OrderStatus.Accepted),
                "executed" => q.Where(o => o.Status == OrderStatus.Executed),
                 "rejected" => q.Where(o => o.Status == OrderStatus.Rejected),
                 "failed" => q.Where(o => o.Status == OrderStatus.Failed),
                "cancelled" => q.Where(o => o.Status == OrderStatus.Cancelled),
                _ => q
            };
            _orders = await q.Take(200).ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnTradeFilterChanged(string value)
    {
        _tradeFilter = value;
        await LoadAsync();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        _filter = value;
        await LoadAsync();
    }

    /// <summary>
    /// Exports the currently filtered/sorted orders as a CSV, enriching each row with
    /// the originating signal and the matching position's entry/exit timings.
    /// </summary>
    private async Task DownloadOrdersAsync()
    {
        if (_downloading) return;
        _downloading = true;

        try
        {
            var orders = SortedOrders.ToList();
            if (orders.Count == 0)
            {
                Snackbar.Add("Nothing to download.", Severity.Info);
                return;
            }

            var positions = await LoadPositionsForAsync(orders);
            var csv = BuildCsv(orders, positions);

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv)).ToArray();
            var fileName = $"orders-{DateTimeExtensions.IstNow():yyyyMMdd-HHmmss}.csv";

            await JS.InvokeVoidAsync("NexusApp.downloadFile", fileName, "text/csv", Convert.ToBase64String(bytes));
            Snackbar.Add($"Downloaded {orders.Count} orders.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloading = false;
        }
    }

    /// <summary>
    /// Positions are keyed by signal + account, so a single lookup covers every exported
    /// order and gives us the real entry (opened) and exit (closed) timings.
    /// </summary>
    private async Task<Dictionary<(int SignalId, int TradingAccountId), NexusApp.Models.Position>> LoadPositionsForAsync(List<Order> orders)
    {
        var signalIds = orders.Select(o => o.SignalId).Distinct().ToList();

        using var db = await DbFactory.CreateDbContextAsync();
        var positions = await db.Positions.AsNoTracking()
            .Where(p => signalIds.Contains(p.SignalId))
            .ToListAsync();

        return positions
            .GroupBy(p => (p.SignalId, p.TradingAccountId))
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.OpenedAt).First());
    }

    private static string BuildCsv(List<Order> orders, Dictionary<(int, int), NexusApp.Models.Position> positions)
    {
        var sb = new StringBuilder();
        sb.AppendLine(string.Join(",",
            "Order Id", "Order Time (IST)", "Executed At (IST)", "Status", "Account", "Broker", "Client Id",
            "Broker Order Id", "Symbol", "Side", "Order Type", "Product", "Quantity", "Price", "Executed Price",
            "Filled Quantity", "Remarks",
            "Signal Id", "Channel", "Signal Action", "Index", "Strike", "Option Type", "Signal Entry Price",
            "Signal Stop Loss", "Signal Targets", "Expiry Date", "Signal Status", "Signal Symbol",
            "Telegram Time (IST)", "Received (IST)", "Processed (IST)", "Signal Delay (ms)",
            "Entry Time (IST)", "Entry Price", "Exit Time (IST)", "Exit Price", "Position Quantity",
            "Position Stop Loss", "Position Targets", "Realized PnL"));

        foreach (var o in orders)
        {
            positions.TryGetValue((o.SignalId, o.TradingAccountId), out var position);
            var signal = o.Signal;

            sb.AppendLine(string.Join(",",
                Csv(o.Id),
                Csv(o.CreatedAt.ToIstString()),
                Csv(o.ExecutedAt.ToIstString()),
                Csv(o.Status),
                Csv(o.TradingAccount?.Name),
                Csv(o.TradingAccount?.BrokerType),
                Csv(o.TradingAccount?.ClientId),
                Csv(o.BrokerId),
                Csv(o.Symbol),
                Csv(o.Side),
                Csv(o.OrderType),
                Csv(o.ProductType),
                Csv(o.Quantity),
                Csv(o.Price),
                Csv(o.ExecutedPrice),
                Csv(o.FilledQuantity),
                Csv(o.ErrorMessage),

                Csv(o.SignalId),
                Csv(signal?.ChannelName),
                Csv(signal?.Action),
                Csv(signal?.Index),
                Csv(signal?.Strike),
                Csv(signal?.OptionType),
                Csv(signal?.EntryPrice),
                Csv(signal?.StopLoss),
                Csv(signal is null ? null : string.Join(" | ", signal.Targets)),
                Csv(signal?.ExpiryDate.ToIstString("yyyy-MM-dd")),
                Csv(signal?.Status),
                Csv(signal?.Symbol),
                Csv(signal?.TelegramTimestamp.ToIstString()),
                Csv(signal?.ReceivedTimestamp.ToIstString()),
                Csv(signal?.ProcessedTimestamp.ToIstString()),
                Csv(signal?.SignalDelayMs),

                Csv(position?.OpenedAt.ToIstString()),
                Csv(position?.EntryPrice),
                Csv(position?.ClosedAt.ToIstString()),
                Csv(position?.ClosingPrice),
                Csv(position?.Quantity),
                Csv(position?.StopLoss),
                Csv(position is null ? null : string.Join(" | ", position.Targets)),
                Csv(position?.RealizedPnL)));
        }

        return sb.ToString();
    }

    /// <summary>
    /// Escapes a value for CSV: invariant formatting plus quoting when the text
    /// contains a separator, quote or newline.
    /// </summary>
    private static string Csv(object? value)
    {
        if (value is null) return string.Empty;

        var text = value is IFormattable formattable
            ? formattable.ToString(null, CultureInfo.InvariantCulture)
            : value.ToString() ?? string.Empty;

        if (text.IndexOfAny([',', '"', '\n', '\r']) < 0)
            return text;

        return $"\"{text.Replace("\"", "\"\"")}\"";
    }

    private async Task CancelOneAsync(Order order)
    {
        if (string.IsNullOrWhiteSpace(order.BrokerId))
        {
            Snackbar.Add("Cannot cancel: order has no broker id yet.", Severity.Warning);
            return;
        }

        try
        {
            var ok = await Broker.CancelOrderAsync(order.BrokerId);
            if (ok)
            {
                Snackbar.Add($"Cancel requested for {order.BrokerId}", Severity.Success);
                await MarkCancelledAsync(new[] { order.Id });
                await LoadAsync();
            }
            else
            {
                Snackbar.Add($"Broker refused cancel for {order.BrokerId}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelAllOpenAsync()
    {
        var open = _orders.Where(IsCancellable).ToList();
        if (open.Count == 0)
        {
            Snackbar.Add("No open orders to cancel.", Severity.Info);
            return;
        }

        _cancelling = true;
        var ok = 0;
        var failed = 0;
        var updatedIds = new List<int>();
        foreach (var o in open)
        {
            if (string.IsNullOrWhiteSpace(o.BrokerId)) { failed++; continue; }
            try
            {
                if (await Broker.CancelOrderAsync(o.BrokerId))
                {
                    ok++;
                    updatedIds.Add(o.Id);
                }
                else failed++;
            }
            catch { failed++; }
        }

        if (updatedIds.Count > 0)
            await MarkCancelledAsync(updatedIds);

        _cancelling = false;
        Snackbar.Add($"Cancelled {ok} of {open.Count} open orders." + (failed > 0 ? $" {failed} failed." : ""),
            failed == 0 ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private async Task MarkCancelledAsync(IEnumerable<int> ids)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            foreach (var id in ids)
            {
                var o = await db.Orders.FirstOrDefaultAsync(x => x.Id == id);
                if (o is not null && IsCancellable(o))
                {
                    o.Status = OrderStatus.Cancelled;
                    if (string.IsNullOrWhiteSpace(o.ErrorMessage))
                        o.ErrorMessage = "Cancelled from Orders page";
                }
            }
            await db.SaveChangesAsync();
        }
        catch { /* best-effort local mirror */ }
    }

    private static bool IsCancellable(Order o) =>
        o.Status == OrderStatus.Pending || o.Status == OrderStatus.Accepted;

    private static bool IsFailureStatus(OrderStatus s) =>
        s == OrderStatus.Rejected || s == OrderStatus.Failed || s == OrderStatus.Cancelled;

    private Color StatusColor(OrderStatus s) => s switch
    {
        OrderStatus.Executed => Color.Success,
        OrderStatus.Rejected or OrderStatus.Failed => Color.Error,
        OrderStatus.Cancelled => Color.Default,
        OrderStatus.Accepted => Color.Info,
        _ => Color.Warning
    };

    private static string FormatBrokerId(string? brokerId)
    {
        if (string.IsNullOrWhiteSpace(brokerId)) return "-";
        if (brokerId.StartsWith("PAPER-", StringComparison.OrdinalIgnoreCase) || brokerId.Equals("Paper Account", StringComparison.OrdinalIgnoreCase))
            return "Paper Account";
        return brokerId;
    }
}
