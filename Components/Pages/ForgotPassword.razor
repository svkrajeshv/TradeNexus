@page "/forgot-password"
@layout LoginLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject NavigationManager Nav

<PageTitle>Reset Password - NexusApp</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="reset-page d-flex align-center justify-center min-vh-100 pa-4">
    <MudPaper Elevation="4" Class="reset-card pa-6 rounded-lg w-100">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Style="font-weight: 700; letter-spacing: 0.5px;">Reset password</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Verify your connected Telegram account to continue.</MudText>
        </MudStack>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="reset-alert mb-4" Dense="true" Icon="@Icons.Material.Filled.ErrorOutline">@_error</MudAlert>
        }

        @if (_verify)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="reset-alert mb-4" Dense="true">
                A verification code was sent to the connected Telegram account's Saved Messages.
            </MudAlert>

            <form method="post" action="/auth/password-reset/confirm">
                <MudStack Spacing="3">
                    <div>
                        <label for="reset-code" class="reset-label">Verification code</label>
                        <input id="reset-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
                               class="reset-input reset-code-input" required maxlength="6" placeholder="Enter 6-digit code" />
                    </div>
                    <div>
                        <label for="reset-password" class="reset-label">New password</label>
                        <input id="reset-password" name="password" type="password" autocomplete="new-password"
                               class="reset-input" required minlength="8" />
                        <small class="reset-help">Use at least 8 characters.</small>
                    </div>
                    <div>
                        <label for="reset-confirm-password" class="reset-label">Confirm new password</label>
                        <input id="reset-confirm-password" name="confirmPassword" type="password" autocomplete="new-password"
                               class="reset-input" required minlength="8" />
                    </div>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true">
                        Reset password
                    </MudButton>
                </MudStack>
            </form>
        }
        else
        {
            <form method="post" action="/auth/password-reset/request">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  Label="Connected Telegram mobile number"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Phone"
                                  UserAttributes="@(new() { ["name"] = "phoneNumber", ["autocomplete"] = "tel" })" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true">
                        Send verification code
                    </MudButton>
                </MudStack>
            </form>
        }

        <MudDivider Class="my-4" />
        <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">Back to sign in</MudButton>
    </MudPaper>
</MudContainer>

<style>
    .reset-page {
        min-height: 100vh;
        height: auto !important;
        padding-top: 32px !important;
        padding-bottom: 32px !important;
    }

    .reset-card {
        max-width: 520px;
        background: #ffffff;
        border: 1px solid #dbe3ef;
        border-radius: 14px !important;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14) !important;
    }

    .reset-alert {
        border-radius: 8px !important;
        line-height: 1.35;
    }

    .reset-label {
        display: block;
        margin-bottom: 6px;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .reset-input {
        display: block;
        box-sizing: border-box;
        width: 100%;
        min-height: 46px;
        padding: 10px 12px;
        border: 1px solid #b8c4d4;
        border-radius: 7px;
        outline: none;
        background: #ffffff;
        color: #0f172a;
        font: inherit;
        font-size: 0.95rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .reset-input::placeholder {
        color: #94a3b8;
    }

    .reset-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
    }

    .reset-code-input {
        letter-spacing: 0.12em;
        font-weight: 600;
    }

    .reset-help {
        display: block;
        margin-top: 5px;
        color: #64748b;
        font-size: 0.78rem;
    }

    @@media (max-width: 600px) {
        .reset-page {
            align-items: flex-start !important;
            padding: 16px 10px !important;
        }

        .reset-card {
            padding: 20px !important;
        }
    }
</style>

@code {
    private bool _verify;
    private string? _error;

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _verify = query.TryGetValue("step", out var step) && string.Equals(step, "verify", StringComparison.OrdinalIgnoreCase);

        _error = query.TryGetValue("error", out var error) ? error.ToString() switch
        {
            "mismatch" => "The passwords do not match.",
            "invalid" => "The code is invalid or expired. Request a new code and try again.",
            _ => "Unable to send a verification code. Confirm Telegram is connected and try again."
        } : null;
    }
}
