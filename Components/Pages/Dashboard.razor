@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Globalization
@using System.Text.Json
@using NexusApp.Data
@using NexusApp.Helpers
@using NexusApp.Interfaces
@using NexusApp.Models
@using NexusApp.Components.Shared
@using NexusApp.Services
@inject TradingSignalService SignalService
@inject IDbContextFactory<TradingDbContext> DbFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ITradingEngine TradingEngine
@inject ISettingsService SettingsService
@inject NexusApp.Services.HealthSnapshotCache HealthSnapshots
@inject NexusApp.Services.HubConnectionFactory HubFactory
@inject ILogger<Dashboard> Logger
@implements IAsyncDisposable

<PageTitle>Trading Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Trading Dashboard</MudText>
@if (_refreshError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">
        Dashboard data could not be loaded, so the figures below are not live: @_refreshError
    </MudAlert>
}
@if (_hubError is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        Live feed is not connected, so Unrealised / Realised / MTM are unavailable from the
        broker terminal: @_hubError
    </MudAlert>
}
<style>
    .cmp-blink-up {
        animation: cmp-up 0.7s ease-in-out 1;
    }
    .cmp-blink-down {
        animation: cmp-down 0.7s ease-in-out 1;
    }
    .live-signals-table {
        font-size: 0.72rem;
    }
    .live-signals-table th,
    .live-signals-table td {
        padding: 4px 6px !important;
        white-space: nowrap;
    }
    .live-signals-table .mud-chip {
        font-size: 0.68rem;
        height: 22px;
    }
    /* Wide tables scroll horizontally instead of squeezing columns on desktop/tablet. */
    .table-scroll {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    /* Mobile card grid used by the Open Positions list. */
    .position-card {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px 12px;
        width: 100%;
        padding: 12px;
        margin-bottom: 10px;
        border: 1px solid var(--mud-palette-lines-default);
        border-left-width: 4px;
        border-radius: 8px;
        background-color: var(--mud-palette-surface);
    }
    /* Book differentiation: a colored left border + faint row/card tint make the
       Live (real money) vs Paper (simulated) book obvious at a glance, without
       relying on reading the channel text - important on the small mobile cards
       where that text is easy to miss. */
    .position-card--live {
        border-left-color: var(--mud-palette-success);
        background-color: rgba(76, 175, 80, 0.06);
    }
    .position-card--paper {
        border-left-color: var(--mud-palette-tertiary, #9c27b0);
        background-color: rgba(156, 39, 176, 0.05);
    }
    .book-badge {
        font-size: 0.62rem !important;
        height: 20px !important;
        font-weight: 700 !important;
        letter-spacing: 0.3px;
    }
    .position-row--live {
        border-left: 4px solid var(--mud-palette-success);
        background-color: rgba(76, 175, 80, 0.05);
    }
    .position-row--paper {
        border-left: 4px solid var(--mud-palette-tertiary, #9c27b0);
        background-color: rgba(156, 39, 176, 0.04);
    }
    .watchlist-card-full {
        grid-column: 1 / -1;
    }
    .watchlist-card-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--mud-palette-text-secondary);
    }
    .watchlist-card-value {
        font-size: 0.9rem;
        word-break: break-word;
    }
    @@media (max-width: 599.98px) {
        /* MudTable switches to stacked rows below its breakpoint; DataLabel drives
           the "Label   Value" pairs so the rows stay readable on phones. */
        .live-signals-table,
        .watchlist-table {
            font-size: 0.8rem;
        }
        .live-signals-table td,
        .watchlist-table td {
            white-space: normal !important;
            padding: 4px 8px !important;
        }
        .live-signals-table .mud-table-cell-align-right,
        .watchlist-table .mud-table-cell-align-right {
            text-align: right;
        }
        .live-signals-table .mud-table-row,
        .watchlist-table .mud-table-row {
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }
        .live-signals-table .mud-table-cell-mobile:before,
        .watchlist-table .mud-table-cell-mobile:before {
            font-weight: 600;
            font-size: 0.68rem;
            text-transform: uppercase;
            color: var(--mud-palette-text-secondary);
        }
    }
    /* Stat cards always share a single row - 5 normally, 6 when the MTM card is live.
       Applies at every breakpoint so mobile shows one compact row instead of a
       full-width card per stat. The Live Signals item below stays xs=12 and wraps. */
    .dashboard-grid > .stat-card {
        flex-basis: 20%;
        max-width: 20%;
    }
    .dashboard-grid.has-mtm > .stat-card {
        flex-basis: 16.6667%;
        max-width: 16.6667%;
    }
    /* Keep every stat card the same height regardless of content. */
    .dashboard-grid > .stat-card > .mud-paper {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    @@media (max-width: 599.98px) {
        /* Two cards per row on phones - one row of five is unreadably narrow.
           Note: do NOT override the grid item padding here. MudGrid Spacing="3"
           pairs a -12px negative margin on the container with 12px padding on
           each item; shrinking only the padding pulls the edge cards outside the
           container and misaligns them against the full-width items below. */
        .dashboard-grid > .stat-card,
        .dashboard-grid.has-mtm > .stat-card {
            flex-basis: 50%;
            max-width: 50%;
        }
        .dashboard-grid > .stat-card > .mud-paper {
            padding: 10px 12px !important;
        }
        .dashboard-grid > .stat-card .mud-typography-subtitle2 {
            font-size: 0.7rem;
            line-height: 1.25;
        }
        .dashboard-grid > .stat-card .mud-typography-h4 {
            font-size: 1.4rem;
            line-height: 1.3;
        }
    }
    @@keyframes cmp-up {
        0% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0.9); }
        100% { box-shadow: 0 0 0 8px rgba(47, 158, 68, 0); }
    }
    @@keyframes cmp-down {
        0% { box-shadow: 0 0 0 0 rgba(224, 49, 49, 0.9); }
        100% { box-shadow: 0 0 0 8px rgba(224, 49, 49, 0); }
    }
</style>

<MudToggleGroup T="PnlMode" Value="_pnlMode" ValueChanged="OnPnlModeChanged" Color="Color.Primary"
                Size="Size.Small" CheckMark="false" SelectionMode="SelectionMode.SingleSelection" Class="mb-3">
    <MudToggleItem Value="PnlMode.All" Text="All" />
    <MudToggleItem Value="PnlMode.Live" Text="Live" />
    <MudToggleItem Value="PnlMode.Paper" Text="Paper" />
</MudToggleGroup>

<MudGrid Class="@($"dashboard-grid{(_isMtmLive ? " has-mtm" : string.Empty)}")" Spacing="3">
    <MudItem xs="12" sm="6" md="3" Class="stat-card">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Today's Signals</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Primary" />
            </MudStack>
            <MudText Typo="Typo.h4">@_todaySignals</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="stat-card">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Open Positions</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Color="Color.Info" />
            </MudStack>
            <MudText Typo="Typo.h4">@_openPositions</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="stat-card">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Executed Today</MudText>
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Info" />
            </MudStack>
            <MudText Typo="Typo.h4">@_executedToday</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="stat-card">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Unrealised P&amp;L</MudText>
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Error" />
            </MudStack>
            @if (FiguresKnown)
            {
                <MudText Typo="Typo.h4" Color="@(_totalPnL >= 0 ? Color.Success : Color.Error)">
                    ₹@_totalPnL.ToString("N2")
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h4" Color="Color.Secondary">₹0.00</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="stat-card">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Realised P&amp;L</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" />
            </MudStack>
            @if (FiguresKnown)
            {
                <MudText Typo="Typo.h4" Color="@(_realizedPnL >= 0 ? Color.Success : Color.Error)">
                    ₹@_realizedPnL.ToString("N2")
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h4" Color="Color.Secondary">₹0.00</MudText>
            }
        </MudPaper>
    </MudItem>
    @if (_isMtmLive && FiguresKnown)
    {
        <MudItem xs="12" sm="6" md="3" Class="stat-card">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">MTM (Live)</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Success" />
                </MudStack>
                <MudText Typo="Typo.h4" Color="@(_mtmNet >= 0 ? Color.Success : Color.Error)">
                    ₹@_mtmNet.ToString("N2")
                </MudText>
            </MudPaper>
        </MudItem>
    }

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h6">Live Signals</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                        Crossed: @GetCrossedCount() / @_signals.Count
                    </MudChip>
                </MudStack>
                <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Size="Size.Small">Refresh</MudButton>
            </MudStack>
            @if (_signals.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No signals received yet. Configure Telegram in appsettings.json and enable it.</MudAlert>
            }
            else
            {
                <div class="table-scroll">
                <MudTable Class="live-signals-table" Items="_signals" Dense="true" Hover="true" Bordered="false" Striped="true" Breakpoint="Breakpoint.Sm" RowStyleFunc="GetSignalRowStyle">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Channel</MudTh>
                        <MudTh>Signal</MudTh>
                        <MudTh>Signal Values</MudTh>
                        <MudTh>CMP</MudTh>
                        <MudTh>Delay</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <LiveSignalRow Signal="context"
                                       CmpDisplay="@GetCmpDisplay(context)"
                                       HasCrossed="@HasCmpCrossedEntry(context)"
                                       BlinkClass="@GetCmpBlinkClass(context)"
                                       DelayText="@FormatDelay(context.SignalDelayMs)"
                                       Staleness="@ToTuple(GetSignalStaleness(context))"
                                       StatusColor="@StatusColor(context.Status)"
                                       StatusReason="@GetStatusReason(context)"                                       IsEditable="@IsEditable(context)"
                                       IsPendingAutoExecution="@IsPendingAutoExecution(context)"
                                       OnSave="@(s => SaveAsync(s))"
                                       OnBuy="@(s => BuyAsync(s))"
                                       OnIgnore="@(s => IgnoreAsync(s))"
                                       OnCancelPendingAuto="@(s => CancelPendingAutoAsync(s))" />
                    </RowTemplate>
                </MudTable>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h6">Watchlist (Active Traded Signals)</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                        @_watchlist.Count active
                    </MudChip>
                </MudStack>
            </MudStack>
            @if (_watchlist.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No active traded signals in watchlist.</MudText>
            }
            else
            {
                <div class="table-scroll">
                <MudTable Class="watchlist-table" Items="_watchlist" Dense="true" Hover="true" Bordered="false" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Channel</MudTh>
                        <MudTh>Signal</MudTh>
                        <MudTh>Entry</MudTh>
                        <MudTh>CMP</MudTh>
                        <MudTh>Low</MudTh>
                        <MudTh>High</MudTh>
                        <MudTh>Exit</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Time">@context.ReceivedTimestamp.ToIstString("hh:mm:ss tt")</MudTd>
                        <MudTd DataLabel="Channel">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                @(string.IsNullOrWhiteSpace(context.ChannelName) ? "-" : context.ChannelName)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Signal">@context.Index @FormatStrike(context.Strike) @context.OptionType.ToString().ToUpper()</MudTd>
                        <MudTd DataLabel="Entry">@GetEdit(context).EntryPrice.ToString("0.##")</MudTd>
                        <MudTd DataLabel="CMP">
                            <MudChip T="string"
                                     Color="@(HasCmpCrossedEntry(context) ? Color.Success : Color.Info)"
                                     Variant="Variant.Filled"
                                     Size="Size.Small"
                                     Class="@GetCmpBlinkClass(context)">
                                @GetCmpDisplay(context)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Low">@GetTickValueDisplay(_lowBySignal, context.Id)</MudTd>
                        <MudTd DataLabel="High">@GetTickValueDisplay(_highBySignal, context.Id)</MudTd>
                        <MudTd DataLabel="Exit">@GetExitDisplay(context.Id)</MudTd>
                        <MudTd DataLabel="Status">
                            <MudTooltip Text="@GetStatusReason(context)" Placement="Placement.Top" Arrow="true" Disabled="@(string.IsNullOrWhiteSpace(GetStatusReason(context)))">
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Size="Size.Small"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => RemoveFromWatchlistAsync(context))">
                                Remove
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">Open Positions</MudText>
            @if (_openPositions == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No open positions.</MudText>
            }
            else
            {
                <!-- Desktop Table View (hidden on mobile) -->
                <div class="d-none d-sm-flex flex-column">
                    <div class="grid-height-box table-scroll">
                    <MudTable Items="DisplayPositions" Dense="true" Hover="true" RowClassFunc="@GetPositionRowClass">
                        <HeaderContent>
                            <MudTh>Symbol</MudTh>
                            <MudTh>Book</MudTh>
                            <MudTh>Channel</MudTh>
                            <MudTh>Qty</MudTh>
                            <MudTh>Entry</MudTh>
                            <MudTh>LTP</MudTh>
                            <MudTh>SL</MudTh>
                            <MudTh>Target 1</MudTh>
                            <MudTh>P&amp;L</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Symbol</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="book-badge"
                                         Color="@(BookScope.IsPaper(context) ? Color.Tertiary : Color.Success)">
                                    @(BookScope.IsPaper(context) ? "PAPER" : "LIVE")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    @(string.IsNullOrWhiteSpace(context.Signal?.ChannelName) ? "-" : context.Signal.ChannelName)
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.Quantity</MudTd>
                            <MudTd>@context.EntryPrice</MudTd>
                            <MudTd>@context.CurrentPrice</MudTd>
                            <MudTd>@(context.StopLoss?.ToString("0.##") ?? "-")</MudTd>
                            <MudTd>@(context.Targets.Count > 0 ? context.Targets[0].ToString("0.##") : "-")</MudTd>
                            <MudTd>
                                <MudText Color="@(context.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                                    @context.UnrealizedPnL.ToString("N2")
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Close"
                                           OnClick="@(() => SquareOffPositionAsync(context))">
                                    Square Off
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    </div>
                </div>

                <!-- Mobile Card View (shown on mobile only) -->
                <div class="d-flex d-sm-none">
                    <MudStack Class="w-100">
                        @foreach (var position in DisplayPositions)
                        {
                            <div class="position-card @(BookScope.IsPaper(position) ? "position-card--paper" : "position-card--live")">
                                <div class="watchlist-card-full d-flex justify-space-between align-center">
                                    <div class="watchlist-card-value" style="font-weight:600;">@position.Symbol</div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="book-badge"
                                             Color="@(BookScope.IsPaper(position) ? Color.Tertiary : Color.Success)">
                                        @(BookScope.IsPaper(position) ? "PAPER" : "LIVE")
                                    </MudChip>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">Channel</div>
                                    <div class="watchlist-card-value">@(position.Signal?.ChannelName ?? "-")</div>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">Qty</div>
                                    <div class="watchlist-card-value">@position.Quantity</div>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">Entry</div>
                                    <div class="watchlist-card-value">@position.EntryPrice</div>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">LTP</div>
                                    <div class="watchlist-card-value">@position.CurrentPrice</div>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">SL</div>
                                    <div class="watchlist-card-value">@(position.StopLoss?.ToString("0.##") ?? "-")</div>
                                </div>

                                <div>
                                    <div class="watchlist-card-label">Target 1</div>
                                    <div class="watchlist-card-value">@(position.Targets.Count > 0 ? position.Targets[0].ToString("0.##") : "-")</div>
                                </div>

                                <div class="watchlist-card-full">
                                    <div class="watchlist-card-label">P&amp;L</div>
                                    <div class="watchlist-card-value">
                                        <MudText Color="@(position.UnrealizedPnL >= 0 ? Color.Success : Color.Error)" style="font-weight: 600; font-size: 0.95rem;">
                                            ₹@position.UnrealizedPnL.ToString("N2")
                                        </MudText>
                                    </div>
                                </div>

                                <div class="watchlist-card-full">
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Close"
                                               OnClick="@(() => SquareOffPositionAsync(position))">
                                        Square Off
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </MudStack>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private HubConnection? _hub;
    private bool _disposed;
    private List<TradingSignal> _signals = new();
    private List<TradingSignal> _watchlist = new();
    private List<NexusApp.Models.Position> _positions = new();
    private readonly Dictionary<int, SignalEditModel> _edits = new();
    private readonly Dictionary<int, decimal> _cmpBySignal = new();
    private readonly Dictionary<int, decimal> _lowBySignal = new();
    private readonly Dictionary<int, decimal> _highBySignal = new();
    private readonly Dictionary<int, decimal> _exitBySignal = new();
    /// <summary>Broker/engine failure text per signal id, shown as a tooltip on the status chip.</summary>
    private readonly Dictionary<int, string> _failureReasonBySignal = new();
    private readonly Dictionary<int, int> _cmpTickDirBySignal = new();
    private readonly Dictionary<int, DateTime> _cmpTickAtBySignal = new();
    private readonly HashSet<int> _hiddenWatchlistSignalIds = new();
    private int _todaySignals;
    private string? _refreshError;
    private string? _hubError;

    /// <summary>Rows rendered in the Open Positions table; the stat cards always
    /// count the full <see cref="_positions"/> list so the two can never disagree.</summary>
    private const int DisplayPositionLimit = 20;

    /// <summary>Which book the stat cards report on.</summary>
    public enum PnlMode { All, Live, Paper }
    private PnlMode _pnlMode = PnlMode.All;

    // Realised P&L is booked history, so it is queried per book in RefreshAsync
    // rather than derived from the in-memory open-position list.
    private decimal _realizedLive;
    private decimal _realizedPaper;

    // "Executed today" is per book, so it is counted from the Orders table (the only
    // entity that carries a TradingAccount link). TradingSignal has no account, which
    // is why the old signal-based count could never respond to the Live/Paper toggle.
    private int _executedLive;
    private int _executedPaper;
    private int _executedAll;

    // Live MTM card state, fed by the HealthMonitorService "HealthTick" broadcast.
    private bool _brokerConnected;
    private DateTime? _mtmAtIst;

    // Broker-truth live figures from the same HealthTick. The broker position book
    // reports realised P&L for legs that are fully squared off (netqty 0) and have no
    // matching local Position row, so it is a better absolute level than our DB
    // aggregate for the live book.
    private bool _hasBrokerTick;
    private decimal _liveUnrealizedTick;
    private decimal _liveRealizedTick;

    private static bool IsPaperPosition(NexusApp.Models.Position p) => BookScope.IsPaper(p);

    private IEnumerable<NexusApp.Models.Position> ScopedPositions => _pnlMode switch
    {
        PnlMode.Live => _positions.Where(BookScope.IsLive),
        PnlMode.Paper => _positions.Where(IsPaperPosition),
        _ => _positions
    };

    private IEnumerable<NexusApp.Models.Position> DisplayPositions =>
        ScopedPositions.Take(DisplayPositionLimit);

    private int _openPositions => ScopedPositions.Count();

    private int _executedToday => _pnlMode switch
    {
        PnlMode.Live => _executedLive,
        PnlMode.Paper => _executedPaper,
        _ => _executedAll
    };

    private decimal PaperUnrealized => _positions.Where(IsPaperPosition).Sum(p => p.UnrealizedPnL);

    private decimal LocalLiveUnrealized => _positions.Where(BookScope.IsLive).Sum(p => p.UnrealizedPnL);

    /// <summary>
    /// Broker figures are only trusted while the broker is actually connected. The
    /// health tick always carries a LiveUnrealized value (it falls back to a local or
    /// zero figure when offline), so latching on its mere presence would pin the live
    /// book to a stale - often zero - number for the rest of the session.
    /// </summary>
    private bool UseBrokerTruth => _brokerConnected && _hasBrokerTick;

    // Do not adjust a terminal P&L total with locally marked CMP movement, and never
    // substitute a locally derived figure for it. The local rows need not contain every
    // terminal leg (carry-forward, manual and non-app orders are invisible to us), so a
    // DB-derived number silently contradicts the AngelOne "Total G/L" the user reads as
    // truth. When the terminal is unreadable the cards render "--" instead.
    private decimal LiveUnrealized => UseBrokerTruth ? _liveUnrealizedTick : 0m;

    private decimal LiveRealized => UseBrokerTruth ? _liveRealizedTick : 0m;

    /// <summary>
    /// Paper figures are computed entirely in-process and are always known. Live (and
    /// therefore "All") figures are only known while the AngelOne position book is
    /// readable, because that is the only source that sees every terminal leg.
    /// </summary>
    private bool FiguresKnown => _pnlMode == PnlMode.Paper || UseBrokerTruth;

    private decimal _totalPnL => _pnlMode switch
    {
        PnlMode.Live => LiveUnrealized,
        PnlMode.Paper => PaperUnrealized,
        _ => LiveUnrealized + PaperUnrealized
    };

    private decimal _realizedPnL => _pnlMode switch
    {
        PnlMode.Live => LiveRealized,
        PnlMode.Paper => _realizedPaper,
        _ => LiveRealized + _realizedPaper
    };

    /// <summary>
    /// Net MTM for the selected book. Derived from the very same unrealised and
    /// realised properties the other two cards render, so the cards can never
    /// contradict each other and "All" is exactly Live + Paper with no double count.
    /// </summary>
    private decimal _mtmNet => _totalPnL + _realizedPnL;

    /// <summary>
    /// The selected book did something today: it either still holds an open position
    /// or it booked realised P&L. A fully squared-off day has no open positions but
    /// still has a meaningful MTM, so open count alone must not gate the card.
    /// </summary>
    private bool HasBookActivity => _openPositions > 0 || _realizedPnL != 0m;

    /// <summary>
    /// The MTM figure is only meaningful once a tick has arrived and the book has
    /// actually traded; the card is hidden otherwise. Broker connectivity is only
    /// required for the live book - paper MTM is simulated locally.
    /// </summary>
    private bool _isMtmLive =>
        _mtmAtIst.HasValue && HasBookActivity &&
        _pnlMode switch
        {
            PnlMode.Live => _brokerConnected,
            PnlMode.Paper => true,
            _ => _brokerConnected || _positions.Any(IsPaperPosition) || _realizedPaper != 0m
        };

    private void OnPnlModeChanged(PnlMode mode)
    {
        _pnlMode = mode;
        StateHasChanged();
    }
    // Default lots loaded from global settings (Settings page → "Default Lots per Order")
    private decimal _defaultLots = 1;
    // Pending order auto-cancel timeout (Settings page), used to project a
    // remaining-window staleness hint on still-actionable Live Signal rows.
    private int _pendingOrderTimeoutMinutes = 5;

    protected override async Task OnInitializedAsync()
    {
        // Only run for the interactive pass. With prerender enabled this component is
        // built twice; doing the work in both doubles every query and, worse, makes a
        // failure in the interactive instance look like a screen that "went to zero"
        // after briefly showing the prerendered figures.
        if (!RendererInfo.IsInteractive)
            return;

        var saved = await SettingsService.GetSettingAsync<int?>("DefaultQuantity");
        if (saved.HasValue && saved.Value > 0)
            _defaultLots = saved.Value;
        _pendingOrderTimeoutMinutes = await SettingsService.GetSettingAsync<int?>("PendingOrderTimeoutMinutes") ?? 5;
        await LoadHiddenWatchlistIdsAsync();

        // Seed the live cards from the last broadcast health figures so the book
        // toggle renders real numbers straight away instead of zeros until the
        // next 30s HealthTick arrives.
        ApplyHealthSnapshot(HealthSnapshots.Latest);

        await RefreshAsync();
        await ConnectHubAsync();
    }

    private void ApplyHealthSnapshot(NexusApp.Services.HealthSnapshot? snapshot)
    {
        if (snapshot is null)
            return;

        _brokerConnected = snapshot.BrokerConnected;

        if (snapshot.BrokerConnected && snapshot.BrokerPnlAvailable)
        {
            _liveUnrealizedTick = snapshot.LiveUnrealized;
            _liveRealizedTick = snapshot.LiveRealized;
            _hasBrokerTick = true;
        }
        else
        {
            _liveUnrealizedTick = 0m;
            _liveRealizedTick = 0m;
            _hasBrokerTick = false;
        }

        _mtmAtIst = snapshot.TimestampUtc.ToIst();
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = HubFactory.Create(Nav);

            _hub.On<JsonElement>("SignalReceived", async payload =>
            {
                if (_disposed)
                    return;

                await InvokeAsync(async () =>
                {
                    await RefreshAsync();

                    var requiresManual = payload.ValueKind == JsonValueKind.Object &&
                        TryGetProp(payload, out var requiresManualProp, "RequiresManualAction", "requiresManualAction") &&
                        requiresManualProp.ValueKind == JsonValueKind.True;

                    Snackbar.Add(requiresManual ? "New signal received — action required" : "New signal received (auto)", Severity.Info);
                    await JS.InvokeVoidAsync("NexusApp.notify", "Trading Signal", "A new signal was parsed");
                    await JS.InvokeVoidAsync("NexusApp.playSound", requiresManual ? "signal-manual" : "signal-auto");
                });
            });

            _hub.On<JsonElement>("SignalStatusChanged", async _ =>
            {
                if (_disposed)
                    return;

                await InvokeAsync(RefreshAsync);
            });

            _hub.On<JsonElement>("PositionChanged", async _ =>
            {
                if (_disposed)
                    return;

                await InvokeAsync(RefreshAsync);
            });

            _hub.On<JsonElement>("HealthTick", payload =>
            {
                if (_disposed)
                    return;

                _ = InvokeAsync(() =>
                {
                    if (payload.ValueKind != JsonValueKind.Object)
                        return;

                    if (TryGetProp(payload, out var connectedProp, "BrokerConnected", "brokerConnected"))
                        _brokerConnected = connectedProp.ValueKind == JsonValueKind.True;

                    var brokerPnlAvailable = true;
                    if (TryGetProp(payload, out var brokerPnlProp, "BrokerPnlAvailable", "brokerPnlAvailable"))
                        brokerPnlAvailable = brokerPnlProp.ValueKind == JsonValueKind.True;

                    if (_brokerConnected && brokerPnlAvailable)
                    {
                        var applied = false;

                        if (TryGetProp(payload, out var liveUnrealProp, "LiveUnrealized", "liveUnrealized") &&
                            TryGetDecimal(liveUnrealProp, out var liveUnreal))
                        {
                            _liveUnrealizedTick = liveUnreal;
                            applied = true;
                        }

                        if (TryGetProp(payload, out var liveRealProp, "LiveRealized", "liveRealized") &&
                            TryGetDecimal(liveRealProp, out var liveReal))
                        {
                            _liveRealizedTick = liveReal;
                            applied = true;
                        }

                        _hasBrokerTick = applied;
                    }
                    else
                    {
                        // Broker offline or live broker-book unreadable: do not render
                        // local substitutes as terminal-truth live P&L.
                        _hasBrokerTick = false;
                        _liveUnrealizedTick = 0m;
                        _liveRealizedTick = 0m;
                    }

                    // Read as DateTimeOffset: System.Text.Json returns Kind=Local for a
                    // "Z" instant, which would be double-shifted by ToIst().
                    if (TryGetProp(payload, out var tsProp, "Timestamp", "timestamp") &&
                        tsProp.TryGetDateTimeOffset(out var tsOffset))
                        _mtmAtIst = tsOffset.UtcDateTime.ToIst();

                    StateHasChanged();
                });
            });

            _hub.On<JsonElement>("CmpTick", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    if (payload.ValueKind != JsonValueKind.Array)
                        return;

                    var changed = false;
                    foreach (var item in payload.EnumerateArray())
                    {
                        if (!TryGetProp(item, out var idProp, "SignalId", "signalId") ||
                            !idProp.TryGetInt32(out var signalId) ||
                            !TryGetProp(item, out var cmpProp, "Cmp", "cmp") ||
                            !TryGetProp(item, out var symbolProp, "Symbol", "symbol"))
                        {
                            continue;
                        }

                        if (!TryGetDecimal(cmpProp, out var cmp) || cmp <= 0 ||
                            symbolProp.ValueKind != JsonValueKind.String)
                            continue;

                        var symbol = symbolProp.GetString();
                        if (string.IsNullOrWhiteSpace(symbol))
                            continue;

                        if (_cmpBySignal.TryGetValue(signalId, out var previous) && previous > 0 && previous != cmp)
                        {
                            _cmpTickDirBySignal[signalId] = cmp > previous ? 1 : -1;
                            _cmpTickAtBySignal[signalId] = DateTime.UtcNow;
                        }

                        _cmpBySignal[signalId] = cmp;
                        if (TryGetProp(item, out var lowProp, "Low", "low") &&
                            TryGetDecimal(lowProp, out var low) && low > 0)
                            _lowBySignal[signalId] = low;
                        if (TryGetProp(item, out var highProp, "High", "high") &&
                            TryGetDecimal(highProp, out var high) && high > 0)
                            _highBySignal[signalId] = high;

                        foreach (var position in _positions.Where(p =>
                                     p.ClosedAt == null &&
                                     string.Equals(p.Symbol, symbol, StringComparison.OrdinalIgnoreCase)))
                        {
                            position.CurrentPrice = cmp;
                            position.UnrealizedPnL = PnlCalculator.UnrealizedPnl(
                                position.EntryPrice, cmp, position.Quantity);
                            position.UnrealizedPnLPercentage = position.EntryPrice > 0
                                ? position.UnrealizedPnL / (position.EntryPrice * position.Quantity) * 100m
                                : 0m;
                        }

                        changed = true;
                    }

                    if (changed)
                    {
                        // The stat cards read straight off _positions, so marking the rows
                        // above is enough to move Unrealised P&L and MTM with the 1s CMP
                        // stream. Visibility still comes from HealthTick, so only refresh
                        // the stamp once it is live.
                        if (_mtmAtIst.HasValue)
                            _mtmAtIst = DateTime.UtcNow.ToIst();

                        StateHasChanged();
                    }
                });
            });

            _hub.Reconnecting += reconnectingError =>
            {
                if (_disposed)
                    return Task.CompletedTask;

                // While the hub is down no HealthTick arrives, so the live cards silently
                // fall back to DB figures. Say so rather than showing stale numbers.
                _ = InvokeAsync(() =>
                {
                    _hubError = "Reconnecting to the live feed...";
                    StateHasChanged();
                });
                return Task.CompletedTask;
            };

            _hub.Reconnected += connectionId =>
            {
                if (_disposed)
                    return Task.CompletedTask;

                _ = InvokeAsync(async () =>
                {
                    _hubError = null;
                    await RefreshAsync();
                });
                return Task.CompletedTask;
            };

            _hub.Closed += ex =>
            {
                if (_disposed)
                    return Task.CompletedTask;

                _ = InvokeAsync(() =>
                {
                    _hubError = ex is null
                        ? "Live feed disconnected."
                        : $"Live feed disconnected: {ex.Message}";
                    _brokerConnected = false;
                    _hasBrokerTick = false;
                    StateHasChanged();
                });
                return Task.CompletedTask;
            };

            await StartHubWithRetryAsync();
            _hubError = null;
        }
        catch (ObjectDisposedException)
        {
            // The component was disposed (navigation away) while connecting; nothing to report.
        }
        catch (Exception ex)
        {
            // Without the hub there are no HealthTick or CmpTick updates, so every live
            // figure is frozen on whatever the last DB read produced. That must not look
            // like real broker data.
            _hubError = ex.Message;
            Logger.LogError(ex, "Dashboard could not connect to the trading hub");
            Snackbar.Add($"Live feed unavailable: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    // The first negotiate can lose the race with a still-warming host (or a briefly
    // saturated thread pool). Retry with backoff so a transient startup hiccup does not
    // leave the page permanently without a feed. Bails out the moment the component is
    // disposed - otherwise the loop keeps calling StartAsync on a torn-down connection
    // and reports "Cannot access a disposed object" instead of the real failure.
    private async Task StartHubWithRetryAsync()
    {
        const int maxAttempts = 4;
        for (var attempt = 1; ; attempt++)
        {
            if (_disposed || _hub is null)
                return;

            try
            {
                await _hub.StartAsync();
                return;
            }
            catch (ObjectDisposedException)
            {
                return;
            }
            catch (Exception ex) when (attempt < maxAttempts)
            {
                Logger.LogWarning(ex,
                    "Trading hub connect attempt {Attempt}/{MaxAttempts} failed; retrying", attempt, maxAttempts);
                await Task.Delay(TimeSpan.FromSeconds(attempt * 2));
            }
        }
    }

    private async Task RefreshAsync()
    {
        // A hub callback can be dispatched after the user has navigated away: the
        // circuit disposes this component and its scoped IServiceProvider, but an
        // in-flight SignalR handler still runs and would resolve DbFactory /
        // SignalService from that disposed scope (ObjectDisposedException).
        if (_disposed)
            return;

        try
        {
            var allRecent = await SignalService.GetRecentSignalsAsync(50);
            var todayIst = DateTime.UtcNow.ToIst().Date;
            _signals = allRecent
                .Where(s => s.ReceivedTimestamp.ToIst().Date == todayIst &&
                            s.Status != SignalStatus.Executed)
                .Take(30)
                .ToList();

            _todaySignals = allRecent.Count(s => s.ReceivedTimestamp.ToIst().Date == todayIst);

            using var db = await DbFactory.CreateDbContextAsync();
            // Load every open position, not a page of them: these rows are the single
            // source of truth for the Open Positions and Unrealised P&L cards, and a
            // capped list silently under-reported both. Only the table is paged.
            _positions = await db.Positions.AsNoTracking()
                .Include(p => p.Signal)
                .Include(p => p.TradingAccount)
                .Where(p => p.ClosedAt == null)
                .OrderByDescending(p => p.OpenedAt)
                .ToListAsync();
            var watch = await db.TradingSignals.AsNoTracking()
                .Where(s => s.Status == SignalStatus.Pending || s.Status == SignalStatus.Executed)
                .OrderByDescending(s => s.ProcessedTimestamp)
                .Take(20)
                .ToListAsync();
            _watchlist = watch
                .Where(s => !_hiddenWatchlistSignalIds.Contains(s.Id))
                .ToList();

            var watchSignalIds = _watchlist.Select(s => s.Id).ToList();
            _exitBySignal.Clear();
            if (watchSignalIds.Count > 0)
            {
                var closedPositions = await db.Positions.AsNoTracking()
                    .Where(p => watchSignalIds.Contains(p.SignalId) && p.ClosedAt != null && p.ClosingPrice != null)
                    .OrderByDescending(p => p.ClosedAt)
                    .ToListAsync();

                foreach (var position in closedPositions)
                    _exitBySignal.TryAdd(position.SignalId, position.ClosingPrice!.Value);
            }

            // A signal only records that it failed, never why: the broker/engine message
            // lives on the order it produced. Pull the newest error text per signal so the
            // status chip can explain the failure in a tooltip.
            var statusSignalIds = _signals.Select(s => s.Id).Concat(watchSignalIds).Distinct().ToList();
            _failureReasonBySignal.Clear();
            if (statusSignalIds.Count > 0)
            {
                var failedOrders = await db.Orders.AsNoTracking()
                    .Where(o => statusSignalIds.Contains(o.SignalId) &&
                                (o.Status == OrderStatus.Failed || o.Status == OrderStatus.Rejected) &&
                                o.ErrorMessage != null && o.ErrorMessage != "")
                    .OrderByDescending(o => o.CreatedAt)
                    .Select(o => new { o.SignalId, o.ErrorMessage })
                    .ToListAsync();

                foreach (var order in failedOrders)
                    _failureReasonBySignal.TryAdd(order.SignalId, order.ErrorMessage!);
            }

            // Realised P&L is reported for the IST trading day, so the window is the
            // IST midnight boundary expressed in UTC (the storage timezone).
            var todayStart = todayIst.IstToUtc();
            var tomorrowStart = todayIst.AddDays(1).IstToUtc();
            var realizedByBook = await db.Positions
                .Where(p => p.ClosedAt >= todayStart && p.ClosedAt < tomorrowStart)
                .GroupBy(p => EF.Functions.Like(p.TradingAccount.ClientId, BookScope.PaperClientId))
                .Select(g => new { IsPaper = g.Key, Total = g.Sum(p => p.RealizedPnL ?? 0m) })
                .ToListAsync();
            _realizedPaper = realizedByBook.Where(r => r.IsPaper).Sum(r => r.Total);
            _realizedLive = realizedByBook.Where(r => !r.IsPaper).Sum(r => r.Total);

            // "Executed today" counts distinct signals that actually traded, not order
            // fills: one signal produces an entry order and an exit order, which would
            // otherwise double the figure. Order is also the only entity that identifies
            // which book it traded on.
            var executedSignals = await db.Orders
                .Where(o => o.Status == OrderStatus.Executed &&
                            o.ExecutedAt >= todayStart && o.ExecutedAt < tomorrowStart)
                .Select(o => new
                {
                    IsPaper = EF.Functions.Like(o.TradingAccount.ClientId, BookScope.PaperClientId),
                    o.SignalId
                })
                .Distinct()
                .ToListAsync();

            _executedPaper = executedSignals.Count(x => x.IsPaper);
            _executedLive = executedSignals.Count(x => !x.IsPaper);
            // A signal traded on both books yields one row per book above, so the combined
            // figure must be a distinct count rather than live + paper.
            _executedAll = executedSignals.Select(x => x.SignalId).Distinct().Count();

            SyncEdits();
            _refreshError = null;
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The circuit was torn down mid-refresh. Nothing is left to render, and
            // surfacing this as a refresh failure would be misleading.
        }
        catch (Exception ex)
        {
            // A swallowed failure here leaves every card at its default 0, which reads
            // as "flat day" rather than "broken". Log it and say so on screen.
            _refreshError = ex.Message;
            Logger.LogError(ex, "Dashboard refresh failed");
            Snackbar.Add($"Refresh failed: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    private Color StatusColor(SignalStatus s) => s switch
    {
        SignalStatus.Executed => Color.Success,
        SignalStatus.Failed => Color.Error,
        SignalStatus.Ignored => Color.Default,
        SignalStatus.Pending => Color.Warning,
        _ => Color.Info
    };

    /// <summary>
    /// Tooltip text for a signal's status chip. Only failed signals carry an
    /// explanation; when no order-level message was recorded a generic hint is shown
    /// so the chip is never silently unexplained.
    /// </summary>
    private string? GetStatusReason(TradingSignal signal)
    {
        if (signal.Status != SignalStatus.Failed)
            return null;

        return _failureReasonBySignal.TryGetValue(signal.Id, out var reason)
            ? reason
            : "Execution failed - no broker error message was recorded for this signal.";
    }

    private async Task BuyAsync(TradingSignal signal)
    {
        // 1. Persist any edited values (entry/SL/targets) first
        if (!await PersistEditedValuesAsync(signal, showSuccess: false))
            return;

        // 2. Re-fetch the signal with latest saved values
        TradingSignal? refreshed;
        using (var db = await DbFactory.CreateDbContextAsync())
            refreshed = await db.TradingSignals.FindAsync(signal.Id);

        if (refreshed is null)
        {
            Snackbar.Add("Signal not found.", Severity.Error);
            return;
        }

        // 3. Build ParsedSignal from the TradingSignal entity for the engine
        var edit   = GetEdit(signal);
        var parsed = new ParsedSignal
        {
            Action          = refreshed.Action,
            Index           = refreshed.Index,
            Strike          = refreshed.Strike,
            OptionType      = refreshed.OptionType,
            EntryPrice      = refreshed.EntryPrice,
            StopLoss        = refreshed.StopLoss,
            Targets         = refreshed.Targets.ToList(),
            ExpiryDate      = refreshed.ExpiryDate,
            SignalTime      = refreshed.TelegramTimestamp,
            OriginalMessage = refreshed.OriginalMessage,
            Lots            = edit.Lots > 0 ? edit.Lots : _defaultLots
        };

        Snackbar.Add($"Manual BUY dispatched for {signal.Index} {FormatStrike(signal.Strike)}{signal.OptionType.ToString().ToUpper()}", Severity.Info);

        // 4. Execute through the trading engine (paper or live based on settings)
        try
        {
            var ok = await TradingEngine.ExecuteSignalAsync(parsed);
            if (ok)
                Snackbar.Add($"Order placed ✓ {signal.Index} {FormatStrike(signal.Strike)}{signal.OptionType.ToString().ToUpper()}", Severity.Success);
            else
            {
                string reason = string.Empty;
                using (var db = await DbFactory.CreateDbContextAsync())
                {
                    var latestOrder = await db.Orders.AsNoTracking()
                        .Where(o => o.SignalId == signal.Id)
                        .OrderByDescending(o => o.CreatedAt)
                        .FirstOrDefaultAsync();
                    reason = latestOrder?.ErrorMessage ?? string.Empty;
                }

                Snackbar.Add(
                    string.IsNullOrWhiteSpace(reason)
                        ? "Order failed — check logs for details (risk limits, duplicate check, or broker error)."
                        : $"Order rejected: {reason}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Order error: {ex.Message}", Severity.Error);
        }

        await RefreshAsync();
    }

    private async Task SquareOffPositionAsync(NexusApp.Models.Position position)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to square off {position.Symbol} at market price?");

        if (!confirmed)
            return;

        try
        {
            var ok = await TradingEngine.SquareOffPositionAsync(position.Id);
            Snackbar.Add(
                ok ? $"Square-off submitted for {position.Symbol}." : $"Square-off failed for {position.Symbol}.",
                ok ? Severity.Success : Severity.Error);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Square-off failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync(TradingSignal signal)
    {
        await PersistEditedValuesAsync(signal, showSuccess: true);
    }

    private async Task IgnoreAsync(TradingSignal signal)
    {
        await SignalService.UpdateSignalStatusAsync(signal.Id, SignalStatus.Ignored);
        Snackbar.Add($"Signal ignored", Severity.Normal);
        await RefreshAsync();
    }

    /// <summary>
    /// In Auto trading mode, signals that are waiting on a background trigger
    /// (entry price crossing, or an activation phrase from the channel) are not
    /// yet executed and have no Save/BUY/Ignore actions since the user is not
    /// meant to edit them. This still leaves the user with no way to stop the
    /// engine from executing them once the trigger condition is met, so a
    /// standalone Cancel action is offered for these two statuses only.
    /// </summary>
    private bool IsPendingAutoExecution(TradingSignal signal) =>
        signal.Status == SignalStatus.AwaitingEntry || signal.Status == SignalStatus.AwaitingActivation;

    private async Task CancelPendingAutoAsync(TradingSignal signal)
    {
        await SignalService.UpdateSignalStatusAsync(signal.Id, SignalStatus.Ignored);
        Snackbar.Add("Signal cancelled before execution", Severity.Normal);
        await RefreshAsync();
    }

    private async Task RemoveFromWatchlistAsync(TradingSignal signal)
    {
        _hiddenWatchlistSignalIds.Add(signal.Id);
        await SaveHiddenWatchlistIdsAsync();
        _watchlist = _watchlist.Where(s => s.Id != signal.Id).ToList();
        SyncEdits();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }

    private bool IsEditable(TradingSignal signal) =>
        signal.Status == SignalStatus.Parsed || signal.Status == SignalStatus.Pending;

    private SignalEditModel GetEdit(TradingSignal signal)
    {
        if (!_edits.TryGetValue(signal.Id, out var edit))
        {
            edit = new SignalEditModel
            {
                EntryPrice  = Math.Max(0, signal.EntryPrice - 10),
                StopLoss    = Math.Max(0, signal.StopLoss - 50),
                TargetsText = BuildDefaultTargetText(signal),
                Lots        = _defaultLots
            };
            _edits[signal.Id] = edit;
        }

        return edit;
    }

    private void OnEntryChanged(int signalId, decimal value)
    {
        if (_edits.TryGetValue(signalId, out var edit))
            edit.EntryPrice = value;
    }

    private void OnStopLossChanged(int signalId, decimal value)
    {
        if (_edits.TryGetValue(signalId, out var edit))
            edit.StopLoss = value;
    }

    private void OnTargetsChanged(int signalId, string value)
    {
        if (_edits.TryGetValue(signalId, out var edit))
            edit.TargetsText = value;
    }

    private void OnLotsChanged(int signalId, decimal value)
    {
        if (_edits.TryGetValue(signalId, out var edit))
            edit.Lots = Math.Max(1, value);
    }

    private void SyncEdits()
    {
        var activeIds = _signals.Select(s => s.Id)
            .Concat(_watchlist.Select(s => s.Id))
            .ToHashSet();
        foreach (var id in _edits.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _edits.Remove(id);
        foreach (var id in _cmpBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _cmpBySignal.Remove(id);
        foreach (var id in _lowBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _lowBySignal.Remove(id);
        foreach (var id in _highBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _highBySignal.Remove(id);
        foreach (var id in _exitBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _exitBySignal.Remove(id);
        foreach (var id in _cmpTickDirBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _cmpTickDirBySignal.Remove(id);
        foreach (var id in _cmpTickAtBySignal.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _cmpTickAtBySignal.Remove(id);

        foreach (var signal in _signals)
            _ = GetEdit(signal);
    }

    private async Task<bool> PersistEditedValuesAsync(TradingSignal signal, bool showSuccess)
    {
        if (!_edits.TryGetValue(signal.Id, out var edit))
            return true;

        if (!TryParseTargets(edit.TargetsText, out var targets, out var error))
        {
            Snackbar.Add(error, Severity.Warning);
            return false;
        }

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.TradingSignals.FindAsync(signal.Id);
            if (entity is null)
            {
                Snackbar.Add("Signal not found while saving edits.", Severity.Error);
                return false;
            }

            entity.EntryPrice = edit.EntryPrice;
            entity.StopLoss = edit.StopLoss;
            entity.Targets = targets;
            entity.ProcessedTimestamp = DateTime.UtcNow;
            await db.SaveChangesAsync();

            signal.EntryPrice = edit.EntryPrice;
            signal.StopLoss = edit.StopLoss;
            signal.Targets = targets;
            edit.TargetsText = string.Join(" / ", targets);

            if (showSuccess)
                Snackbar.Add("Signal values updated.", Severity.Success);

            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save signal edits: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private static bool TryParseTargets(string raw, out List<decimal> values, out string error)
    {
        values = new List<decimal>();
        error = string.Empty;

        if (string.IsNullOrWhiteSpace(raw))
        {
            error = "Targets cannot be empty.";
            return false;
        }

        var parts = raw.Split(new[] { '/', ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (!decimal.TryParse(part, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) &&
                !decimal.TryParse(part, NumberStyles.Number, CultureInfo.CurrentCulture, out parsed))
            {
                error = $"Invalid target value: {part}";
                return false;
            }

            values.Add(parsed);
        }

        if (values.Count == 0)
        {
            error = "At least one target is required.";
            return false;
        }

        return true;
    }

    private sealed class SignalEditModel
    {
        public decimal EntryPrice { get; set; }
        public decimal StopLoss { get; set; }
        public string TargetsText { get; set; } = string.Empty;
        public decimal Lots { get; set; } = 1;
    }

    private static string FormatStrike(decimal strike) =>
        strike.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatDelay(decimal ms)
    {
        if (ms <= 0) return "-";
        var seconds = (double)ms / 1000.0;
        return seconds < 1
            ? $"{seconds:0.00} s"
            : seconds < 60
                ? $"{seconds:0.0} s"
                : seconds < 3600
                    ? $"{seconds / 60:0.0} min"
                    : $"{seconds / 3600:0.0} h";
    }

    private readonly record struct SignalStalenessInfo(string Text, Color Color);

    /// <summary>
    /// Projects the remaining window before an unfilled limit order (placed right
    /// now off this signal) would be auto-cancelled, based on the "Pending Order
    /// Auto-Cancel" setting and how long the signal has already been sitting
    /// unactioned since it was received.
    /// </summary>
    private SignalStalenessInfo? GetSignalStaleness(TradingSignal signal)
    {
        if (_pendingOrderTimeoutMinutes <= 0 || !(IsEditable(signal) || IsPendingAutoExecution(signal)))
            return null;

        var elapsed = DateTime.UtcNow - signal.ReceivedTimestamp.EnsureUtc();
        var remaining = TimeSpan.FromMinutes(_pendingOrderTimeoutMinutes) - elapsed;

        if (remaining <= TimeSpan.Zero)
            return new SignalStalenessInfo("Cancelling...", Color.Error);

        var totalWindow = TimeSpan.FromMinutes(_pendingOrderTimeoutMinutes);
        var fractionRemaining = remaining.TotalSeconds / totalWindow.TotalSeconds;
        var color = fractionRemaining switch
        {
            < 0.2 => Color.Error,
            < 0.5 => Color.Warning,
            _ => Color.Default
        };

        return new SignalStalenessInfo($"{FormatCountdown(remaining)} left", color);
    }

    private static string FormatCountdown(TimeSpan remaining)
    {
        if (remaining.TotalMinutes >= 1)
            return $"{(int)remaining.TotalMinutes}m {remaining.Seconds}s";
        return $"{Math.Max(0, remaining.Seconds)}s";
    }

    private static (string Text, Color Color)? ToTuple(SignalStalenessInfo? info) =>
        info is { } i ? (i.Text, i.Color) : null;

    private static string BuildDefaultTargetText(TradingSignal signal)
    {
        var firstTarget = signal.Targets.Count > 0 ? signal.Targets[0] : signal.EntryPrice;
        var adjusted = Math.Max(0, firstTarget - 10);
        return adjusted.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private string GetCmpDisplay(TradingSignal signal) =>
        _cmpBySignal.TryGetValue(signal.Id, out var cmp) && cmp > 0
            ? cmp.ToString("0.##", CultureInfo.InvariantCulture)
            : "—";

    private static string GetTickValueDisplay(Dictionary<int, decimal> values, int signalId) =>
        values.TryGetValue(signalId, out var value) && value > 0
            ? value.ToString("0.##", CultureInfo.InvariantCulture)
            : "—";

    private string GetExitDisplay(int signalId) =>
        _exitBySignal.TryGetValue(signalId, out var exitPrice) && exitPrice > 0
            ? exitPrice.ToString("0.##", CultureInfo.InvariantCulture)
            : "-";

    private bool HasCmpCrossedEntry(TradingSignal signal)
    {
        if (!_cmpBySignal.TryGetValue(signal.Id, out var cmp) || cmp <= 0) return false;
        var entry = GetEdit(signal).EntryPrice;
        return signal.Action == SignalAction.Buy
            ? PriceComparison.IsGreaterThanOrEqual(cmp, entry)
            : PriceComparison.IsLessThanOrEqual(cmp, entry);
    }

    private string GetSignalRowStyle(TradingSignal signal, int rowNumber)
    {
        if (!HasCmpCrossedEntry(signal)) return string.Empty;
        return signal.Action == SignalAction.Buy
            ? "background-color: rgba(47,158,68,0.18);"
            : "background-color: rgba(224,49,49,0.18);";
    }

    private int GetCrossedCount() => _signals.Count(HasCmpCrossedEntry);

    /// <summary>
    /// Colors the whole Open Positions row by book (live vs paper) so the two are
    /// distinguishable at a glance on desktop without reading the Book chip text.
    /// </summary>
    private static string GetPositionRowClass(NexusApp.Models.Position position, int rowNumber) =>
        BookScope.IsPaper(position) ? "position-row--paper" : "position-row--live";

    private string GetCmpBlinkClass(TradingSignal signal)
    {
        if (!_cmpTickDirBySignal.TryGetValue(signal.Id, out var dir) || dir == 0)
            return string.Empty;
        if (!_cmpTickAtBySignal.TryGetValue(signal.Id, out var at))
            return string.Empty;
        if ((DateTime.UtcNow - at) > TimeSpan.FromSeconds(2))
            return string.Empty;
        return dir > 0 ? "cmp-blink-up" : "cmp-blink-down";
    }

    private static bool TryGetDecimal(JsonElement value, out decimal parsed)
    {
        parsed = 0m;
        if (value.ValueKind == JsonValueKind.Number)
            return value.TryGetDecimal(out parsed);
        if (value.ValueKind == JsonValueKind.String)
            return decimal.TryParse(value.GetString(), NumberStyles.Number, CultureInfo.InvariantCulture, out parsed)
                   || decimal.TryParse(value.GetString(), NumberStyles.Number, CultureInfo.CurrentCulture, out parsed);
        return false;
    }

    // Case-insensitive property probe — SignalR's JSON hub protocol may emit
    // camelCase (default) or PascalCase depending on server configuration.
    private static bool TryGetProp(JsonElement obj, out JsonElement value, params string[] names)
    {
        for (var i = 0; i < names.Length; i++)
        {
            if (obj.TryGetProperty(names[i], out value))
                return true;
        }
        value = default;
        return false;
    }

    private async Task LoadHiddenWatchlistIdsAsync()
    {
        _hiddenWatchlistSignalIds.Clear();
        var raw = await SettingsService.GetSettingAsync<string>("Watchlist.HiddenSignalIds");
        if (string.IsNullOrWhiteSpace(raw))
            return;

        foreach (var part in raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var id))
                _hiddenWatchlistSignalIds.Add(id);
        }
    }

    private Task SaveHiddenWatchlistIdsAsync()
    {
        var serialized = string.Join(",", _hiddenWatchlistSignalIds.OrderBy(i => i));
        return SettingsService.SetSettingAsync("Watchlist.HiddenSignalIds", serialized);
    }
